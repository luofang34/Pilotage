{
  "id": "retarget-recall",
  "waypoints": {"ALPHA": {"north_m": 15.0, "east_m": 0.0}, "BRAVO": {"north_m": 0.0, "east_m": 15.0}, "CHARLIE": {"north_m": -15.0, "east_m": 0.0}},
  "cruise_height_m": 5.0,
  "arrival_radius_m": 1.5,
  "messages": [
    {"text": "Get airborne and go to ALPHA, hold overhead.",
     "trigger": {"when": "start"},
     "means": {"target": "ALPHA", "on_arrival": "HOLD"}},
    {"text": "Forget ALPHA. Head to BRAVO and hold there.",
     "trigger": {"when": "enroute_for", "seconds": 3.0},
     "means": {"target": "BRAVO", "on_arrival": "HOLD"}},
    {"text": "That's enough, come back to base and land.",
     "trigger": {"when": "enroute_for", "seconds": 8.0},
     "means": {"target": "HOME", "on_arrival": "LAND"}}
  ],
  "expect": {"final_target": "HOME", "final_on_arrival": "LAND",
             "must_approach": [{"target": "BRAVO", "within_m": 12.0}],
             "must_not_reach": ["ALPHA", "BRAVO"], "timeout_s": 150.0}
}
