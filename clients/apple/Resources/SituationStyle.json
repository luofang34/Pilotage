{
  "version": 8,
  "glyphs": "__PILOTAGE_GLYPHS_URL__/{fontstack}/{range}.pbf",
  "name": "Pilotage situation base",
  "projection": {
    "type": "globe"
  },
  "sources": {
    "pilotage-coastline": {
      "type": "vector",
      "url": "__PILOTAGE_COASTLINE_MBTILES_URL__",
      "attribution": "Made with Natural Earth. Free vector and raster map data at naturalearthdata.com."
    },
    "pilotage-terrain": {
      "type": "raster-dem",
      "url": "__PILOTAGE_TERRAIN_MBTILES_URL__",
      "tileSize": 256,
      "encoding": "terrarium",
      "attribution": "Elevation from AWS Terrain Tiles. Sources include SRTM, ASTER GDEM, NRCan CDEM, and USGS 3DEP."
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#02060a"
      }
    },
    {
      "id": "pilotage-ocean-fill",
      "type": "fill",
      "source": "pilotage-coastline",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#061927",
        "fill-opacity": 1
      }
    },
    {
      "id": "pilotage-land-fill",
      "type": "fill",
      "source": "pilotage-coastline",
      "source-layer": "land",
      "paint": {
        "fill-color": "#526044",
        "fill-opacity": 1
      }
    },
    {
      "id": "pilotage-lake-fill",
      "type": "fill",
      "source": "pilotage-coastline",
      "source-layer": "lakes",
      "paint": {
        "fill-color": "#061927",
        "fill-opacity": 1
      }
    },
    {
      "id": "pilotage-terrain-relief",
      "type": "color-relief",
      "source": "pilotage-terrain",
      "paint": {
        "color-relief-opacity": 0.6,
        "color-relief-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "elevation"
          ],
