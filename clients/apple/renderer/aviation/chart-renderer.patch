+//! Scale chart ink and its clearances together relative to a calibrated paper view.
+
+use std::collections::HashMap;
+
+use serde::Deserialize;
+use serde_json::Value;
+use thiserror::Error;
+
+use super::layer::StyleLayer;
+
+const KEY: &str = "maplibre:paper-scale";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Specification {
+    reference_zoom: f64,
+    min_relative_zoom: Option<f64>,
+    source_min_zoom: Option<u8>,
+    clearance_thresholds: Option<[f64; 3]>,
+}
+
+/// Invalid chart calibration cannot silently turn into a different scale.
+#[derive(Debug, Error)]
+pub enum PaperScaleError {
+    /// The layer's calibration descriptor cannot be decoded.
+    #[error("invalid paper scale for layer {layer}: {source}")]
+    Decode {
+        /// Layer carrying the descriptor.
+        layer: String,
+        /// Malformed field or value.
+        #[source]
+        source: serde_json::Error,
+    },
+    /// The layer requests a scale outside the camera's supported range.
+    #[error("paper scale for layer {layer} has invalid {field}")]
+    Range {
+        /// Layer carrying the descriptor.
+        layer: String,
+        /// Invalid descriptor field.
+        field: &'static str,
+    },
+}
+
+/// Validate optional paper metadata while decoding a style layer.
+pub fn validate(
+    metadata: Option<&HashMap<String, Value>>,
+    layer: &str,
+) -> Result<(), PaperScaleError> {
+    let Some(value) = metadata.and_then(|entries| entries.get(KEY)) else {
+        return Ok(());
+    };
+    let spec: Specification =
+        serde_json::from_value(value.clone()).map_err(|source| PaperScaleError::Decode {
+            layer: layer.to_owned(),
+            source,
+        })?;
+    for (field, valid) in [
+        (
+            "reference_zoom",
+            (0.0..=24.0).contains(&spec.reference_zoom),
+        ),
+        (
+            "source_min_zoom",
+            spec.source_min_zoom.is_none_or(|zoom| zoom <= 24),
+        ),
+        (
+            "min_relative_zoom",
+            spec.min_relative_zoom
+                .is_none_or(|value| (-24.0..=24.0).contains(&value)),
+        ),
+    ] {
+        if !valid {
+            return Err(PaperScaleError::Range {
+                layer: layer.to_owned(),
+                field,
+            });
+        }
+    }
+    if spec.clearance_thresholds.is_some_and(|values| {
+        values.iter().any(|value| !(-24.0..=24.0).contains(value))
+            || values.windows(2).any(|pair| pair[0] > pair[1])
+    }) {
+        return Err(PaperScaleError::Range {
+            layer: layer.to_owned(),
+            field: "clearance_thresholds",
+        });
+    }
+    Ok(())
+}
+
+/// Ink magnification and visibility at the active camera zoom.
+pub fn evaluate(layer: &StyleLayer, zoom: f32) -> [f32; 2] {
+    let Some(value) = layer.metadata.as_ref().and_then(|entries| entries.get(KEY)) else {
+        return [1.0, 1.0];
+    };
+    let Some(reference) = value.get("reference_zoom").and_then(Value::as_f64) else {
+        return [1.0, 1.0];
+    };
+    let relative = f64::from(zoom - reference as f32);
+    let visible = value
+        .get("min_relative_zoom")
+        .and_then(Value::as_f64)
+        .is_none_or(|minimum| relative >= minimum);
+    [2.0_f64.powf(relative) as f32, f32::from(visible)]
+}
+
+/// Finest source level required by paper layers whose ink is currently visible.
+pub fn minimum_tile_zoom(layers: &[StyleLayer], zoom: f32, source_maximum: u8) -> u8 {
+    layers
+        .iter()
+        .filter(|layer| evaluate(layer, zoom)[1] > 0.0)
+        .filter_map(|layer| {
+            layer
+                .metadata
+                .as_ref()?
+                .get(KEY)?
+                .get("source_min_zoom")?
+                .as_u64()
+        })
+        .filter_map(|minimum| u8::try_from(minimum).ok())
+        .max()
+        .unwrap_or(0)
+        .min(source_maximum)
+}
+
+/// Select no exclusion, point, rose, or bearing clearance from the same camera rules.
+pub fn clearance(layer: &StyleLayer, zoom: f32) -> [f32; 2] {
+    let metadata = layer.metadata.as_ref();
+    let paper = metadata.and_then(|entries| entries.get(KEY));
+    let scale = metadata
+        .and_then(|entries| entries.get("maplibre:line-endpoint-disks"))
+        .and_then(|value| value.get("scale"))
+        .and_then(Value::as_f64)
+        .unwrap_or(1.0);
+    let Some((reference, thresholds)) = paper.and_then(|value| {
+        Some((
+            value.get("reference_zoom")?.as_f64()?,
+            value.get("clearance_thresholds")?.as_array()?,
+        ))
+    }) else {
+        return [3.0, scale as f32];
+    };
+    let relative = f64::from(zoom - reference as f32);
+    let mode = thresholds
+        .iter()
+        .filter_map(Value::as_f64)
+        .take_while(|threshold| relative >= *threshold)
+        .count();
+    [mode as f32, scale as f32]
+}
