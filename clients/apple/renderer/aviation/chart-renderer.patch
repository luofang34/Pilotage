+
+fn anchor(x: f64, y: f64, extent: f64) -> (f64, f64) {
+    let mut tessellator = TextTessellatorNew {
+        coordinate_scale: 4096.0 / extent,
+        ..Default::default()
+    };
+    tessellator.point_begin(0).expect("point begins");
+    tessellator.xy(x, y, 0).expect("point coordinate");
+    tessellator.current_point.expect("normalized anchor")
+}
+
+#[test]
+fn buffered_anchors_have_the_same_world_position_in_adjacent_tiles() {
+    for extent in [1024.0, 4096.0, 8192.0] {
+        for value in [-3.0, -1.0, 1.0, 3.0] {
+            let buffered = anchor(value, value, extent);
+            let neighbor = anchor(value + extent, value + extent, extent);
+            assert_eq!((buffered.0 + 4096.0, buffered.1 + 4096.0), neighbor);
+        }
+    }
+}
