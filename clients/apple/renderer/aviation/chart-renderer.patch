+//! Reserve each component's projected envelope while leaving space between components.
+
+use super::{placement::Footprint, projection};
+use crate::{
+    projection::globe::camera::GlobeCameraState,
+    render::{shaders::ShaderLayerMetadata, view_state::ViewState},
+    sdf::{Feature, SymbolLayerData},
+};
+
+pub(super) fn shapes(
+    layer: &SymbolLayerData,
+    feature: &Feature,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+    padding: f64,
+    ink: bool,
+) -> Option<Vec<Footprint>> {
+    if ink {
+        let points = convex_hull(super::text_ink::points(layer, feature, view, globe, paint)?)?;
+        return Some(vec![Footprint::Polygon { points, padding }]);
+    }
+    let mut points = Vec::new();
+    for index in layer
+        .new_buffer
+        .buffer
+        .indices
+        .get(feature.indices.clone())?
+    {
+        let vertex = layer.new_buffer.buffer.vertices.get(*index as usize)?;
+        points.push(projection::vertex_position(
+            vertex,
+            layer.coords,
+            view,
+            globe,
+            paint,
+        )?);
+    }
+    let points = convex_hull(points)?;
+    Some(vec![Footprint::Polygon { points, padding }])
+}
+
+fn convex_hull(mut points: Vec<[f64; 2]>) -> Option<Vec<[f64; 2]>> {
+    if points.iter().flatten().any(|value| !value.is_finite()) {
+        return None;
+    }
+    points.sort_by(|a, b| a[0].total_cmp(&b[0]).then_with(|| a[1].total_cmp(&b[1])));
+    points.dedup();
+    let mut lower = chain(points.iter().copied());
+    let mut upper = chain(points.iter().rev().copied());
+    lower.pop();
+    upper.pop();
+    lower.extend(upper);
+    (lower.len() >= 3).then_some(lower)
+}
+
+fn chain(points: impl Iterator<Item = [f64; 2]>) -> Vec<[f64; 2]> {
+    let mut result = Vec::new();
+    for point in points {
+        while result.len() >= 2
+            && turn(result[result.len() - 2], result[result.len() - 1], point) <= 0.0
+        {
+            result.pop();
+        }
+        result.push(point);
+    }
+    result
+}
+
+fn turn(a: [f64; 2], b: [f64; 2], c: [f64; 2]) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
