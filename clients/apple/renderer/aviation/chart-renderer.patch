+//! Sprite placement before icon scaling and rotation.
+
+use crate::style::{
+    expression::{LegacyPropertySpec, PropertyKind, Value},
+    property::PropertyValue,
+};
+use serde::Serialize;
+
+/// Displacement in logical sprite pixels.
+#[derive(Debug, Clone, Serialize)]
+pub struct IconOffset(pub [f64; 2]);
+
+impl PropertyValue for IconOffset {
+    fn spec() -> LegacyPropertySpec {
+        LegacyPropertySpec::interpolated(PropertyKind::Array {
+            item: Box::new(PropertyKind::Number),
+            length: Some(2),
+        })
+    }
+
+    fn from_value(value: &Value) -> Option<Self> {
+        let Value::Array(values) = value else {
+            return None;
+        };
+        let [x, y] = values.as_slice() else {
+            return None;
+        };
+        Some(Self([x.as_number()?, y.as_number()?]))
+    }
+}
+
+/// Evaluated placement of one sprite relative to its geographic point.
+#[derive(Debug, Clone, Copy)]
+pub struct IconPlacement {
+    /// Horizontal and vertical anchor fractions, measured from the top left.
+    pub anchor: [f64; 2],
+    /// Offset in the sprite's unrotated logical pixels.
+    pub offset: [f64; 2],
+}
+
+impl Default for IconPlacement {
+    fn default() -> Self {
+        Self {
+            anchor: [0.5; 2],
+            offset: [0.0; 2],
+        }
+    }
+}
+
+pub(super) fn anchor(value: &str) -> [f64; 2] {
+    match value {
+        "left" => [0.0, 0.5],
+        "right" => [1.0, 0.5],
+        "top" => [0.5, 0.0],
+        "bottom" => [0.5, 1.0],
+        "top-left" => [0.0, 0.0],
+        "top-right" => [1.0, 0.0],
+        "bottom-left" => [0.0, 1.0],
+        "bottom-right" => [1.0, 1.0],
+        _ => [0.5; 2],
+    }
+}
