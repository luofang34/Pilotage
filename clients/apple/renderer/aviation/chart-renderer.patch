+//! Rasterize the convex outline of one placed label, preserving its map rotation.
+
+fn cross(a: [f64; 2], b: [f64; 2], c: [f64; 2]) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+
+fn hull(mut points: Vec<[f64; 2]>) -> Vec<[f64; 2]> {
+    points.retain(|p| p.iter().all(|v| v.is_finite()));
+    points.sort_by(|a, b| a[0].total_cmp(&b[0]).then(a[1].total_cmp(&b[1])));
+    points.dedup();
+    let mut outline = Vec::new();
+    for point in &points {
+        while outline.len() >= 2
+            && cross(
+                outline[outline.len() - 2],
+                outline[outline.len() - 1],
+                *point,
+            ) <= 0.0
+        {
+            outline.pop();
+        }
+        outline.push(*point);
+    }
+    let lower = outline.len();
+    for point in points.iter().rev().skip(1) {
+        while outline.len() > lower
+            && cross(
+                outline[outline.len() - 2],
+                outline[outline.len() - 1],
+                *point,
+            ) <= 0.0
+        {
+            outline.pop();
+        }
+        outline.push(*point);
+    }
+    outline.pop();
+    outline
+}
+
+pub(super) fn paint(pixels: &mut [u8], dimensions: [u32; 2], points: Vec<[f64; 2]>) {
+    let polygon = hull(points);
+    if polygon.len() < 3 {
+        return;
+    }
+    let [width, height] = dimensions.map(|n| n as usize);
+    let top = polygon
+        .iter()
+        .map(|p| p[1])
+        .fold(f64::INFINITY, f64::min)
+        .floor()
+        .max(0.0) as usize;
+    let bottom = polygon
+        .iter()
+        .map(|p| p[1])
+        .fold(f64::NEG_INFINITY, f64::max)
+        .ceil()
+        .clamp(0.0, height as f64) as usize;
+    for y in top..bottom {
+        let scan = y as f64 + 0.5;
+        let mut left = f64::INFINITY;
+        let mut right = f64::NEG_INFINITY;
+        for (a, b) in polygon
+            .iter()
+            .zip(polygon.iter().cycle().skip(1))
+            .take(polygon.len())
+        {
+            if (a[1] <= scan && scan < b[1]) || (b[1] <= scan && scan < a[1]) {
+                let x = a[0] + (scan - a[1]) * (b[0] - a[0]) / (b[1] - a[1]);
+                left = left.min(x);
+                right = right.max(x);
+            }
+        }
+        if !left.is_finite() || !right.is_finite() {
+            continue;
+        }
+        let start = left.floor().clamp(0.0, width as f64) as usize;
+        let end = right.ceil().clamp(0.0, width as f64) as usize;
+        pixels[y * width + start..y * width + end].fill(255);
+    }
+}
