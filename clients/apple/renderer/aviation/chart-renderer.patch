+//! Symbol dimensions evaluated at the active camera zoom.
+
+use crate::{
+    render::shaders::ShaderLayerMetadata,
+    style::layer::{LayerPaint, StyleLayer},
+};
+
+pub(crate) fn layer_metadata(layer: &StyleLayer, zoom: f32) -> ShaderLayerMetadata {
+    let (text_size, icon_size) = match &layer.paint {
+        Some(LayerPaint::Symbol(paint)) => (
+            paint
+                .text_size
+                .as_ref()
+                .and_then(|size| size.evaluate_at_zoom(f64::from(zoom)))
+                .filter(|size| size.is_finite() && *size >= 0.0)
+                .unwrap_or(16.0),
+            paint.icon.size_at_zoom(f64::from(zoom)),
+        ),
+        _ => (16.0, 1.0),
+    };
+    let mut metadata = ShaderLayerMetadata::new(layer.index as f32, text_size, [0.0; 2]);
+    metadata.circle_params[0] = icon_size;
+    [metadata.paper_scale, metadata.paper_opacity] = crate::style::paper::evaluate(layer, zoom);
+    metadata.circle_params[3] = metadata.paper_scale;
+    if let Some(LayerPaint::Symbol(paint)) = &layer.paint {
+        let (foreground, halo, width, opacity) = paint.text_style.paint(f64::from(zoom));
+        metadata.stroke_color = foreground;
+        metadata.circle_flags = halo;
+        metadata.circle_params[1] = width;
+        metadata.circle_params[2] = opacity * metadata.paper_opacity;
+    }
+    metadata
+}
