+//! Glyph sampling borders do not occupy paper space or interrupt neighboring strokes.
+
+use super::projection;
+use crate::{
+    projection::globe::camera::GlobeCameraState,
+    render::{shaders::ShaderLayerMetadata, view_state::ViewState},
+    sdf::{Feature, SymbolLayerData},
+};
+
+pub(super) fn points(
+    layer: &SymbolLayerData,
+    feature: &Feature,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+) -> Option<Vec<[f64; 2]>> {
+    let buffer = &layer.new_buffer.buffer;
+    let indices = buffer.indices.get(feature.indices.clone())?;
+    if indices.len() % 6 != 0 {
+        return None;
+    }
+    let mut result = Vec::new();
+    for quad in indices.chunks_exact(6) {
+        if quad[1] != quad[3] || quad[2] != quad[4] {
+            return None;
+        }
+        let first = buffer.vertices.get(quad[0] as usize)?;
+        let right = buffer.vertices.get(quad[1] as usize)?;
+        let bottom = buffer.vertices.get(quad[2] as usize)?;
+        let dimensions = [
+            right.a_data[0].checked_sub(first.a_data[0])?,
+            bottom.a_data[1].checked_sub(first.a_data[1])?,
+        ];
+        let mut screen = [([0.0; 2], 1.0); 4];
+        for (i, index) in [quad[0], quad[1], quad[5], quad[2]].into_iter().enumerate() {
+            let vertex = buffer.vertices.get(index as usize)?;
+            if vertex.a_data[2] & 1 == 0 {
+                return None;
+            }
+            screen[i] = projection::vertex_projection(vertex, layer.coords, view, globe, paint)?;
+        }
+        result.extend(inset(screen, dimensions)?);
+    }
+    (!result.is_empty()).then_some(result)
+}
+
+fn inset(screen: [([f64; 2], f64); 4], dimensions: [u32; 2]) -> Option<[[f64; 2]; 4]> {
+    if dimensions.into_iter().any(|n| n <= 6)
+        || screen
+            .iter()
+            .any(|(point, w)| !w.is_finite() || *w <= 0.0 || point.iter().any(|n| !n.is_finite()))
+    {
+        return None;
+    }
+    let [u, v] = dimensions.map(|n| 3.0 / f64::from(n));
+    let points = [[u, v], [1.0 - u, v], [1.0 - u, 1.0 - v], [u, 1.0 - v]]
+        .map(|uv| project_corner(screen, uv));
+    points
+        .iter()
+        .flatten()
+        .all(|n| n.is_finite())
+        .then_some(points)
+}
+
+fn project_corner(screen: [([f64; 2], f64); 4], [u, v]: [f64; 2]) -> [f64; 2] {
+    let (weights, triangle) = if u + v <= 1.0 {
+        ([1.0 - u - v, u, v], [screen[0], screen[1], screen[3]])
+    } else {
+        (
+            [1.0 - v, u + v - 1.0, 1.0 - u],
+            [screen[1], screen[2], screen[3]],
+        )
+    };
+    let w: f64 = weights.iter().zip(triangle).map(|(b, (_, w))| b * w).sum();
+    std::array::from_fn(|axis| {
+        weights
+            .iter()
+            .zip(triangle)
+            .map(|(b, (point, w))| b * w * point[axis])
+            .sum::<f64>()
+            / w
+    })
+}
