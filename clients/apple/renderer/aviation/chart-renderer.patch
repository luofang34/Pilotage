+//! Compact display geometry retains source centers and versioned physical radius units.
+
+use geozero::error::GeozeroError;
+use serde::Deserialize;
+
+use super::invalid;
+use crate::{
+    coords::WorldTileCoords,
+    style::{expression::FeatureProperties, layer::StyleProperty},
+};
+
+#[derive(Clone, Debug, Deserialize)]
+enum Encoding {
+    #[serde(rename = "mercator21-radius8-v1")]
+    Mercator21Radius8,
+    #[serde(rename = "mercator21-radius4-v2")]
+    Mercator21Radius4,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum Profile {
+    Low,
+    High,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct PackedDisks {
+    encoding: Encoding,
+    profile: Profile,
+    scale: f64,
+    start: serde_json::Value,
+    end: serde_json::Value,
+    zoom_radii: Option<serde_json::Value>,
+}
+
+impl PackedDisks {
+    fn zoom_radii(&self, properties: &FeatureProperties, zoom: f64) -> Result<u64, GeozeroError> {
+        let Some(expression) = self
+            .zoom_radii
+            .as_ref()
+            .filter(|_| matches!(self.profile, Profile::Low))
+        else {
+            return Ok(0);
+        };
+        let number: f64 = StyleProperty::parse(expression)
+            .evaluate_for(properties, zoom)
+            .ok_or_else(|| invalid("missing zoom clearance radii"))?;
+        if !number.is_finite()
+            || number.fract() != 0.0
+            || !(0.0..=68_719_476_735.0).contains(&number)
+        {
+            return Err(invalid(
+                "zoom clearance radii must be a 36-bit unsigned integer",
+            ));
+        }
+        Ok(number as u64)
+    }
+
+    pub(super) fn evaluate(
+        &self,
+        properties: &FeatureProperties,
+        zoom: f64,
+        coords: WorldTileCoords,
+        anchors: [Option<[f32; 2]>; 2],
+    ) -> Result<[[f32; 4]; 2], GeozeroError> {
+        let units = match self.encoding {
+            Encoding::Mercator21Radius8 => 8.0,
+            Encoding::Mercator21Radius4 => 4.0,
+        };
+        if !self.scale.is_finite() || !(0.0..=16.0).contains(&self.scale) {
+            return Err(invalid("invalid physical display scale"));
+        }
+        let mut result = [[0.0; 4]; 2];
+        let zoom_radii = self.zoom_radii(properties, zoom)?;
+        for (index, expression) in [&self.start, &self.end].iter().enumerate() {
+            let number: f64 = StyleProperty::parse(expression)
+                .evaluate_for(properties, zoom)
+                .ok_or_else(|| invalid("missing packed endpoint value"))?;
+            if !number.is_finite()
+                || number.fract() != 0.0
+                || !(-2047.0..=9_007_199_254_740_991.0).contains(&number)
+            {
+                return Err(invalid(
+                    "packed endpoint must be a 53-bit unsigned value or negative geometry-relative code",
+                ));
+            }
+            let packed = number.abs() as u64;
+            let flags = (packed >> 9) & 3;
+            let profile = match self.profile {
+                Profile::Low => 1,
+                Profile::High => 2,
+            };
+            if flags & profile == 0 {
+                continue;
+            }
+            let radius = (packed & 511) as f64 / units * self.scale;
+            let stages = ((zoom_radii >> (index * 18)) & 262_143) as f32;
+            if number < 0.0 {
+                let anchor = anchors[index]
+                    .ok_or_else(|| invalid("geometry-relative exclusion has no endpoint"))?;
+                result[index] = [anchor[0], anchor[1], radius as f32, stages];
+                continue;
+            }
+            let tiles = 2_f64.powi(i32::from(u8::from(coords.z)));
+            let x = ((packed >> 11) & 2_097_151) as f64 / 2_097_152.0 * tiles;
+            let y = (packed >> 32) as f64 / 2_097_152.0 * tiles;
+            let delta = x - coords.x as f64;
+            let local_x = delta - ((delta - 0.5) / tiles).round() * tiles;
+            result[index] = [
+                (local_x * 4096.0) as f32,
+                ((y - coords.y as f64) * 4096.0) as f32,
+                radius as f32,
+                stages,
+            ];
+        }
+        Ok(result)
+    }
+}
