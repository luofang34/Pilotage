+//! Per-layer raster opacity, separate from reusable tile textures.
+
+use std::collections::HashMap;
+
+use wgpu::util::DeviceExt;
+
+use crate::style::{layer::LayerPaint, Style};
+
+struct BoundPaint {
+    opacity: f32,
+    bind_group: wgpu::BindGroup,
+}
+
+#[derive(Default)]
+pub(super) struct RasterLayerPaints {
+    layers: HashMap<String, BoundPaint>,
+}
+
+impl RasterLayerPaints {
+    pub(super) fn get(&self, layer: &str) -> Option<&wgpu::BindGroup> {
+        self.layers.get(layer).map(|paint| &paint.bind_group)
+    }
+
+    pub(super) fn synchronize(
+        &mut self,
+        device: &wgpu::Device,
+        pipeline: &wgpu::RenderPipeline,
+        style: &Style,
+    ) -> bool {
+        let mut changed = false;
+        for layer in style.layers.iter().filter(|layer| layer.type_ == "raster") {
+            let opacity = match &layer.paint {
+                Some(LayerPaint::Raster(paint)) => paint.raster_opacity.unwrap_or(1.0),
+                _ => 1.0,
+            }
+            .clamp(0.0, 1.0);
+            if self
+                .layers
+                .get(&layer.id)
+                .is_some_and(|paint| paint.opacity == opacity)
+            {
+                continue;
+            }
+            let data = [opacity, 0.0, 0.0, 0.0];
+            let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("raster layer paint"),
+                contents: bytemuck::cast_slice(&data),
+                usage: wgpu::BufferUsages::UNIFORM,
+            });
+            let bind_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("raster layer paint"),
+                layout: &pipeline.get_bind_group_layout(2),
+                entries: &[wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: buffer.as_entire_binding(),
+                }],
+            });
+            self.layers.insert(
+                layer.id.clone(),
+                BoundPaint {
+                    opacity,
+                    bind_group,
+                },
+            );
+            changed = true;
+        }
+        let count = self.layers.len();
+        self.layers.retain(|id, _| {
+            style
+                .layers
+                .iter()
+                .any(|layer| layer.type_ == "raster" && layer.id == *id)
+        });
+        changed || count != self.layers.len()
+    }
+}
