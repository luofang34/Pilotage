+//! Only accepted text contributes to route interruption; hidden and rejected labels reserve nothing.
+
+use super::{projection, CollisionLayer};
+use crate::{
+    projection::globe::camera::GlobeCameraState, render::view_state::ViewState,
+    sdf::chart::upload_system::paint::layer_metadata, vector::annotation_mask::AnnotationMask,
+};
+
+pub(super) fn update(
+    mask: &mut AnnotationMask,
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    layers: &[CollisionLayer<'_>],
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+) {
+    let window = view.clip_to_window_transform();
+    mask.begin(device, [window.w.x * 2.0, window.w.y * 2.0]);
+    for layer in layers {
+        if !layer
+            .policy
+            .as_ref()
+            .is_some_and(|policy| policy.clear_lines)
+        {
+            continue;
+        }
+        let paint = layer_metadata(layer.style, view.zoom().level());
+        for feature in &layer.data.features {
+            let buffer = &layer.data.new_buffer.buffer;
+            let Some(indices) = buffer.indices.get(feature.indices.clone()) else {
+                continue;
+            };
+            let visible = indices
+                .first()
+                .and_then(|index| layer.metadata.get(*index as usize))
+                .is_some_and(|metadata| metadata.opacity > 0.0);
+            if !visible {
+                continue;
+            }
+            if layer.policy.as_ref().is_some_and(|policy| policy.text_ink) {
+                if let Some(points) =
+                    super::text_ink::points(layer.data, feature, view, globe, &paint)
+                {
+                    mask.include(points);
+                }
+                continue;
+            }
+            let points: Option<Vec<_>> = indices
+                .iter()
+                .map(|index| {
+                    let vertex = buffer.vertices.get(*index as usize)?;
+                    projection::vertex_position(vertex, layer.data.coords, view, globe, &paint)
+                })
+                .collect();
+            if let Some(points) = points {
+                mask.include(points);
+            }
+        }
+    }
+    mask.upload(queue);
+}
