+use super::paint;
+
+#[test]
+fn rotated_labels_do_not_erase_the_corners_of_their_bounding_box() {
+    let mut pixels = vec![0; 100];
+    paint(
+        &mut pixels,
+        [10, 10],
+        vec![[5.0, 1.0], [9.0, 5.0], [5.0, 9.0], [1.0, 5.0], [5.0, 5.0]],
+    );
+    assert_eq!(pixels[5 * 10 + 5], 255);
+    assert_eq!(pixels[1 * 10 + 1], 0);
+    assert_eq!(pixels[8 * 10 + 8], 0);
+}
+
+#[test]
+fn offscreen_and_duplicate_vertices_are_bounded_by_the_viewport() {
+    let mut pixels = vec![0; 100];
+    paint(
+        &mut pixels,
+        [10, 10],
+        vec![
+            [-10.0, -10.0],
+            [5.0, -10.0],
+            [5.0, 5.0],
+            [-10.0, 5.0],
+            [5.0, 5.0],
+        ],
+    );
+    assert_eq!(pixels.iter().filter(|n| **n == 255).count(), 25);
+    paint(
+        &mut pixels,
+        [10, 10],
+        vec![[20.0, 20.0], [30.0, 20.0], [30.0, 30.0]],
+    );
