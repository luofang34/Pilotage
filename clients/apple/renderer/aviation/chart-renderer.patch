+//! Supply installed map resources to the map and its tile workers.
+
+use std::sync::Arc;
+
+use maplibre::{
+    io::source_client::{ResourceProvider, SourceFetchError},
+    style::Style,
+};
+use pilotage_map_archives::{ResourceBinding, ResourceSet};
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum AviationResourceError {
+    #[error("cannot decode pilotage:resources in the map style")]
+    Configuration(#[source] serde_json::Error),
+    #[error(transparent)]
+    Resource(#[from] pilotage_map_archives::ResourceError),
+}
+
+pub(crate) fn provider(
+    style: &Style,
+) -> Result<Option<Arc<dyn ResourceProvider>>, AviationResourceError> {
+    let Some(value) = style.metadata.get("pilotage:resources") else {
+        return Ok(None);
+    };
+    let bindings: Vec<ResourceBinding> =
+        serde_json::from_value(value.clone()).map_err(AviationResourceError::Configuration)?;
+    Ok(Some(Arc::new(InstalledResources(ResourceSet::new(
+        bindings,
+    )?))))
+}
+
+struct InstalledResources(ResourceSet);
+
+#[async_trait::async_trait]
+impl ResourceProvider for InstalledResources {
+    async fn fetch(&self, url: &str) -> Option<Result<Vec<u8>, SourceFetchError>> {
+        if !url.starts_with("pilotage:") {
+            return None;
+        }
+        Some(match self.0.fetch(url).await {
+            Ok(Some(bytes)) => Ok(bytes),
+            Ok(None) => Err(SourceFetchError::not_found(url)),
+            Err(error) => Err(SourceFetchError(Box::new(error))),
+        })
+    }
+}
