+//! Reject footprints that could leave visible artwork unprotected.
+
+use super::{SpriteError, SpriteIndex};
+
+pub(super) fn validate(index: &SpriteIndex, url: &str, required: bool) -> Result<(), SpriteError> {
+    for (id, entry) in index {
+        let hull = &entry.collision_hull;
+        if hull.is_empty() && !required {
+            continue;
+        }
+        if !(3..=256).contains(&hull.len())
+            || hull
+                .iter()
+                .any(|p| p[0] > entry.width || p[1] > entry.height)
+            || !convex(hull)
+        {
+            return Err(SpriteError::CollisionHull {
+                id: id.clone(),
+                url: url.into(),
+            });
+        }
+    }
+    Ok(())
+}
+
+fn convex(points: &[[u32; 2]]) -> bool {
+    let mut sign = None;
+    for (i, a) in points.iter().enumerate() {
+        let next = (i + 1) % points.len();
+        let b = points[next];
+        for (j, c) in points.iter().enumerate() {
+            if j == i || j == next {
+                continue;
+            }
+            let cross = (i128::from(b[0]) - i128::from(a[0]))
+                * (i128::from(c[1]) - i128::from(a[1]))
+                - (i128::from(b[1]) - i128::from(a[1])) * (i128::from(c[0]) - i128::from(a[0]));
+            if cross == 0 || sign.is_some_and(|value| value != (cross > 0)) {
+                return false;
+            }
+            sign = Some(cross > 0);
+        }
+    }
+    sign.is_some()
+}
