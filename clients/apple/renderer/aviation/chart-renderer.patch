+#![allow(clippy::expect_used, clippy::panic)]
+
+use super::*;
+use crate::style::expression::Value;
+use serde_json::json;
+
+#[test]
+fn compact_endpoint_values_retain_profile_selection_and_calibrated_radius() {
+    let packed = (753664_u64 << 32) | (360448_u64 << 11) | (2 << 9) | 96;
+    let properties = FeatureProperties::from_iter([("disk".into(), Value::Number(packed as f64))]);
+    for (profile, radius) in [("low", 0.0), ("high", 24.0)] {
+        let descriptor = json!({"encoding": "mercator21-radius8-v1", "profile": profile,
+            "scale": 2, "start": ["get", "disk"], "end": 0});
+        let disks = EndpointDisks::parse(
+            &descriptor,
+            WorldTileCoords {
+                x: 5,
+                y: 11,
+                z: 5.into(),
+            },
+        )
