+//! Project symbol vertices with the shader's size, paper scale and alignment.
+
+use super::{
+    canonical_tile,
+    placement::{Bounds, Footprint},
+};
+use crate::{
+    coords::WorldTileCoords,
+    projection::globe::camera::GlobeCameraState,
+    render::{
+        shaders::{ShaderLayerMetadata, ShaderSymbolVertexNew},
+        view_state::ViewState,
+    },
+    sdf::{Feature, SymbolLayerData},
+};
+use cgmath::Vector4;
+
+pub(super) fn bounds(
+    layer: &SymbolLayerData,
+    feature: &Feature,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+) -> Option<Bounds> {
+    let anchor = [
+        f64::from(feature.text_anchor.x),
+        f64::from(feature.text_anchor.y),
+    ];
+    project(anchor, layer.coords, view, globe)?;
+    let mut result = Bounds::empty();
+    for index in feature.indices.clone() {
+        let vertex = layer
+            .new_buffer
+            .buffer
+            .vertices
+            .get(*layer.new_buffer.buffer.indices.get(index)? as usize)?;
+        let point = vertex_position(vertex, layer.coords, view, globe, paint)?;
+        result.include(point);
+    }
+    result.is_finite().then_some(result)
+}
+
+pub(super) fn connector_shapes(
+    layer: &SymbolLayerData,
+    feature: &Feature,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+    padding: f64,
+) -> Option<Vec<Footprint>> {
+    let mut shapes = Vec::new();
+    for triangle in layer
+        .new_buffer
+        .buffer
+        .indices
+        .get(feature.indices.clone())?
+        .chunks_exact(3)
+    {
+        let mut points = [[0.0; 2]; 3];
+        for (index, vertex) in triangle.iter().enumerate() {
+            points[index] = vertex_position(
+                layer.new_buffer.buffer.vertices.get(*vertex as usize)?,
+                layer.coords,
+                view,
+                globe,
+                paint,
+            )?;
+        }
+        shapes.push(Footprint::Triangle { points, padding });
+    }
+    (!shapes.is_empty()).then_some(shapes)
+}
+
+fn project(
+    position: [f64; 2],
+    coords: WorldTileCoords,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+) -> Option<[f64; 2]> {
+    project_with_w(position, coords, view, globe).map(|(screen, _)| screen)
+}
+
+pub(super) fn vertex_position(
+    vertex: &ShaderSymbolVertexNew,
+    coords: WorldTileCoords,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+) -> Option<[f64; 2]> {
+    vertex_projection(vertex, coords, view, globe, paint).map(|(screen, _)| screen)
+}
+
+fn project_with_w(
+    position: [f64; 2],
+    coords: WorldTileCoords,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+) -> Option<([f64; 2], f64)> {
+    let clip = if let Some(camera) = globe {
+        let projected =
+            camera.project_tile_coordinates(position[0], position[1], canonical_tile(coords)?, 0.0);
+        if projected.is_occluded || projected.signed_distance_from_camera <= 0.0 {
+            return None;
+        }
+        Vector4::new(projected.point.x, projected.point.y, 0.0, 1.0)
+    } else {
+        let transform = view
+            .view_projection()
+            .to_model_view_projection(coords.transform_for_zoom(view.zoom()));
+        transform.project(Vector4::new(position[0], position[1], 0.0, 1.0))
+    };
+    if clip.w <= 0.0 {
+        return None;
+    }
+    let window = view.clip_to_window(&clip);
+    (window.x.is_finite() && window.y.is_finite()).then_some(([window.x, window.y], clip.w))
+}
+
+pub(super) fn vertex_projection(
+    vertex: &ShaderSymbolVertexNew,
+    coords: WorldTileCoords,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+) -> Option<([f64; 2], f64)> {
+    let offset = pixel_offset(vertex, paint);
+    let anchor = [
+        f64::from(vertex.a_pos_offset[0]),
+        f64::from(vertex.a_pos_offset[1]),
+    ];
+    if vertex.a_pixeloffset[3] == 1 {
+        let (screen, w) = project_with_w(anchor, coords, view, globe)?;
+        return Some(([screen[0] + offset[0], screen[1] + offset[1]], w));
+    }
+    let factor = 8.0 * 2.0_f64.powf(f64::from(u8::from(coords.z)) - view.zoom().value());
+    project_with_w(
+        [
+            anchor[0] + offset[0] * factor,
+            anchor[1] + offset[1] * factor,
+        ],
+        coords,
+        view,
+        globe,
+    )
+}
+
+pub(super) fn pixel_offset(
+    vertex: &ShaderSymbolVertexNew,
+    paint: &ShaderLayerMetadata,
+) -> [f64; 2] {
+    let size = if vertex.a_data[2] & 1 == 0 {
+        f64::from(paint.circle_params[0]) * f64::from(vertex.a_pixeloffset[2]) / 256.0
+    } else {
+        f64::from(paint.line_width) / 24.0
+    };
+    std::array::from_fn(|axis| {
+        (f64::from(vertex.a_pos_offset[axis + 2]) / 32.0 * size
+            + f64::from(vertex.a_pixeloffset[axis]) / 16.0)
+            * f64::from(paint.paper_scale)
+    })
+}
+
+pub(super) fn camera(
+    style: &crate::style::Style,
+    view: &ViewState,
+) -> Result<Option<GlobeCameraState>, crate::tcs::system::SystemError> {
+    let uses_globe = style.projection.as_ref().is_some_and(|spec| {
+        spec.projection_type
+            .uses_globe_rendering(view.zoom().value())
+    });
+    if !uses_globe {
+        return Ok(None);
+    }
+    crate::render::projection::globe_camera_for_view(view)
+        .map(Some)
+        .map_err(|error| {
+            tracing::error!(%error, "unable to project globe symbol collisions");
+            crate::tcs::system::SystemError::Setup
+        })
+}
