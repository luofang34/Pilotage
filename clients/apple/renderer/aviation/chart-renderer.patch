+//! Physical dimensions for unusable-route zigzags.
+
+use serde::Deserialize;
+use std::collections::HashMap;
+
+#[derive(Clone, Copy, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ZigzagSpec {
+    pub height_px: f64,
+    pub period_px: f64,
+    pub paper_nm_per_in: f64,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum ZigzagError {
+    #[error("invalid zigzag specification in layer {layer}")]
+    Decode {
+        layer: String,
+        #[source]
+        source: serde_json::Error,
+    },
+    #[error("zigzag dimensions are out of range in layer {layer}")]
+    Dimensions { layer: String },
+    #[error("zigzag segment requires {vertices} vertices, exceeding 8192")]
+    Capacity { vertices: usize },
+}
+
+pub(crate) fn validate(
+    metadata: Option<&HashMap<String, serde_json::Value>>,
+    layer: &str,
+) -> Result<(), ZigzagError> {
+    let Some(value) = metadata.and_then(|m| m.get("maplibre:line-zigzag")) else {
+        return Ok(());
+    };
+    let spec: ZigzagSpec =
+        serde_json::from_value(value.clone()).map_err(|source| ZigzagError::Decode {
+            layer: layer.into(),
+            source,
+        })?;
+    if ![spec.height_px, spec.period_px]
+        .iter()
+        .all(|x| x.is_finite() && (1.0..=64.0).contains(x))
+        || !spec.paper_nm_per_in.is_finite()
+        || !(0.1..=1000.0).contains(&spec.paper_nm_per_in)
+    {
+        return Err(ZigzagError::Dimensions {
+            layer: layer.into(),
+        });
+    }
+    Ok(())
+}
