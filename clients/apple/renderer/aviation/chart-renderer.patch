+//! Deterministic placement against screen rectangles, indexed by a bounded grid.
+
+use std::collections::{BTreeSet, HashMap};
+
+mod shape;
+pub(super) use shape::Footprint;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Bounds(pub [f64; 4]);
+
+impl Bounds {
+    pub(super) fn empty() -> Self {
+        Self([
+            f64::INFINITY,
+            f64::INFINITY,
+            f64::NEG_INFINITY,
+            f64::NEG_INFINITY,
+        ])
+    }
+    pub(super) fn include(&mut self, point: [f64; 2]) {
+        self.0[0] = self.0[0].min(point[0]);
+        self.0[1] = self.0[1].min(point[1]);
+        self.0[2] = self.0[2].max(point[0]);
+        self.0[3] = self.0[3].max(point[1]);
+    }
+    pub(super) fn union(&mut self, other: Self) {
+        self.include([other.0[0], other.0[1]]);
+        self.include([other.0[2], other.0[3]]);
+    }
+    pub(super) fn is_finite(self) -> bool {
+        self.0.iter().all(|axis| axis.is_finite())
+    }
+    pub(super) fn padded(self, padding: f64) -> Self {
+        Self([
+            self.0[0] - padding,
+            self.0[1] - padding,
+            self.0[2] + padding,
+            self.0[3] + padding,
+        ])
+    }
+    fn intersects(self, other: Self) -> bool {
+        self.0[0] < other.0[2]
+            && self.0[2] > other.0[0]
+            && self.0[1] < other.0[3]
+            && self.0[3] > other.0[1]
+    }
+    fn cells(self, viewport: [f64; 2]) -> impl Iterator<Item = (i32, i32)> {
+        let x0 = (self.0[0].max(-64.0) / 64.0).floor() as i32;
+        let y0 = (self.0[1].max(-64.0) / 64.0).floor() as i32;
+        let x1 = (self.0[2].min(viewport[0] + 64.0) / 64.0).floor() as i32;
+        let y1 = (self.0[3].min(viewport[1] + 64.0) / 64.0).floor() as i32;
+        (x0..=x1).flat_map(move |x| (y0..=y1).map(move |y| (x, y)))
+    }
+}
+
+pub(super) struct PlacementIndex {
+    viewport: [f64; 2],
+    footprints: Vec<Footprint>,
+    cells: HashMap<(i32, i32), Vec<usize>>,
+}
+
+impl PlacementIndex {
+    pub(super) fn new(viewport: [f64; 2]) -> Self {
+        Self {
+            viewport,
+            footprints: Vec::new(),
+            cells: HashMap::new(),
+        }
+    }
+    pub(super) fn place(
+        &mut self,
+        bounds: Bounds,
+        allow_overlap: bool,
+        block_others: bool,
+    ) -> bool {
+        self.place_all(&[Footprint::Rectangle(bounds)], allow_overlap, block_others)
+    }
+
+    pub(super) fn place_all(
+        &mut self,
+        footprints: &[Footprint],
+        allow_overlap: bool,
+        block_others: bool,
+    ) -> bool {
+        if !allow_overlap && footprints.iter().any(|shape| self.conflicts(shape)) {
+            return false;
+        }
+        if block_others {
+            for shape in footprints {
+                let index = self.footprints.len();
+                for cell in shape.bounds().cells(self.viewport) {
+                    self.cells.entry(cell).or_default().push(index);
+                }
+                self.footprints.push(shape.clone());
+            }
+        }
+        true
+    }
+
+    fn conflicts(&self, shape: &Footprint) -> bool {
+        let candidates: BTreeSet<_> = shape
+            .bounds()
+            .cells(self.viewport)
+            .filter_map(|cell| self.cells.get(&cell))
+            .flatten()
+            .copied()
+            .collect();
+        candidates
+            .iter()
+            .any(|index| shape.intersects(&self.footprints[*index]))
+    }
+}
