+//! Resolve visible source-tile symbols using the same geometry as the GPU.
+
+use crate::{
+    context::MapContext,
+    coords::{TileCoords, WorldTileCoords, ZOOM_BOUNDS},
+    io::tile_sources::TileKind,
+    render::{
+        eventually::{Eventually, Eventually::Initialized},
+        shaders::SDFShaderFeatureMetadata,
+        tile_view_pattern::WgpuTileViewPattern,
+        Renderer,
+    },
+    sdf::{Feature, SymbolBufferPool, SymbolLayerData, SymbolLayersDataComponent},
+    style::{collision::CollisionPolicy, layer::StyleLayer},
+    tcs::system::{System, SystemError, SystemResult},
+};
+use std::{
+    borrow::Cow,
+    collections::{BTreeSet, HashMap},
+};
+
+mod artwork;
+mod components;
+mod groups;
+mod line_clearance;
+mod placement;
+mod projection;
+mod text_ink;
+
+#[derive(Default)]
+pub struct CollisionSystem {}
+impl CollisionSystem {
+    pub fn new() -> Self {
+        Self {}
+    }
+}
+
+impl System for CollisionSystem {
+    fn name(&self) -> Cow<'static, str> {
+        "symbol_collision".into()
+    }
+    fn run(
+        &mut self,
+        MapContext {
+            world,
+            style,
+            view_state,
+            renderer: Renderer { device, queue, .. },
+            ..
+        }: &mut MapContext,
+    ) -> SystemResult {
+        let globe = projection::camera(style, view_state)?;
+        let Some((Initialized(pattern), Initialized(pool), Initialized(mask))) =
+            world.resources.query_mut::<(
+                &mut Eventually<WgpuTileViewPattern>,
+                &mut Eventually<SymbolBufferPool>,
+                &mut Eventually<crate::vector::annotation_mask::AnnotationMask>,
+            )>()
+        else {
+            return Err(SystemError::Dependencies);
+        };
+        let mut source_tiles = BTreeSet::new();
+        for view_tile in pattern.iter() {
+            view_tile.render_kind(TileKind::Vector, |shape| {
+                source_tiles.insert(shape.coords());
+            });
+        }
+        let styles: HashMap<_, _> = style
+            .layers
+            .iter()
+            .map(|layer| (layer.id.as_str(), layer))
+            .collect();
+        let mut layers = Vec::new();
+        for coords in source_tiles {
+            let Some(component) = world.tiles.query::<&SymbolLayersDataComponent>(coords) else {
+                continue;
+            };
+            for layer in &component.layers {
+                let Some(style_layer) = styles.get(layer.style_layer_id.as_str()) else {
+                    continue;
+                };
+                layers.push(CollisionLayer::new(layer, style_layer));
+            }
+        }
+        groups::place(&mut layers, view_state, globe.as_ref());
+        line_clearance::update(mask, device, queue, &layers, view_state, globe.as_ref());
+        for layer in layers {
+            if let Some(entries) = pool.index().get_layers(layer.data.coords) {
+                for entry in entries {
+                    if entry.style_layer.id == layer.data.style_layer_id {
+                        pool.update_feature_metadata(queue, entry, &layer.metadata);
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+struct CollisionLayer<'a> {
+    data: &'a SymbolLayerData,
+    style: &'a StyleLayer,
+    policy: Option<CollisionPolicy>,
+    metadata: Vec<SDFShaderFeatureMetadata>,
+}
+impl<'a> CollisionLayer<'a> {
+    fn new(data: &'a SymbolLayerData, style: &'a StyleLayer) -> Self {
+        Self {
+            data,
+            style,
+            policy: crate::style::collision::policy(style),
+            metadata: vec![
+                SDFShaderFeatureMetadata {
+                    opacity: 1.0,
+                    elevation: 0.0
+                };
+                data.new_buffer.buffer.vertices.len()
+            ],
+        }
+    }
+    fn opacity(&mut self, feature: usize, value: f32) {
+        set_feature_opacity(
+            &self.data.features[feature],
+            self.data,
+            &mut self.metadata,
+            value,
+        );
+    }
+}
+
+fn canonical_tile(coords: WorldTileCoords) -> Option<TileCoords> {
+    let tile_count = i32::try_from(ZOOM_BOUNDS[usize::from(u8::from(coords.z))]).ok()?;
+    if coords.y < 0 || coords.y >= tile_count {
+        return None;
+    }
+    Some(TileCoords {
+        x: coords.x.rem_euclid(tile_count) as u32,
+        y: coords.y as u32,
+        z: coords.z,
+    })
+}
+
+fn set_feature_opacity(
+    feature: &Feature,
+    layer: &SymbolLayerData,
+    metadata: &mut [SDFShaderFeatureMetadata],
+    opacity: f32,
+) {
+    for index in feature.indices.clone() {
+        if let Some(vertex_index) = layer.new_buffer.buffer.indices.get(index) {
+            if let Some(vertex) = metadata.get_mut(*vertex_index as usize) {
+                vertex.opacity = opacity;
+            }
+        }
+    }
+}
