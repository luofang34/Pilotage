+//! Keep compound labels intact while ranking independent symbols across tiles.
+
+use super::{
+    artwork, components,
+    placement::{Bounds, Footprint, PlacementIndex},
+    projection, CollisionLayer,
+};
+use crate::{
+    projection::globe::camera::GlobeCameraState, render::view_state::ViewState,
+    sdf::chart::upload_system::paint::layer_metadata, style::collision::CollisionPolicy,
+};
+use std::collections::BTreeMap;
+
+#[cfg(test)]
+mod tests;
+
+struct Group {
+    bounds: Bounds,
+    shapes: Vec<Footprint>,
+    has_body: bool,
+    policy: CollisionPolicy,
+    members: Vec<(usize, usize)>,
+    order: (u32, i64, i64, String),
+}
+
+pub(super) fn place(
+    layers: &mut [CollisionLayer<'_>],
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+) {
+    let mut groups: Vec<Group> = Vec::new();
+    let mut compounds = BTreeMap::new();
+    for (layer_index, layer) in layers.iter_mut().enumerate() {
+        collect(layer_index, layer, view, globe, &mut groups, &mut compounds);
+    }
+    groups.sort_by(|a, b| {
+        b.policy
+            .priority
+            .cmp(&a.policy.priority)
+            .then_with(|| a.order.cmp(&b.order))
+    });
+    let window = view.clip_to_window_transform();
+    let mut index = PlacementIndex::new([window.w.x * 2.0, window.w.y * 2.0]);
+    for group in groups {
+        let visible = place_group(&mut index, &group);
+        for (layer, feature) in group.members {
+            layers[layer].opacity(feature, if visible { 1.0 } else { 0.0 });
+        }
+    }
+}
+
+fn place_group(index: &mut PlacementIndex, group: &Group) -> bool {
+    if !group.has_body {
+        return false;
+    }
+    if group.shapes.is_empty() {
+        return index.place(
+            group.bounds,
+            group.policy.allow_overlap,
+            group.policy.block_others,
+        );
+    }
+    let mut footprints = group.shapes.clone();
+    if group.bounds.is_finite() {
+        footprints.push(Footprint::Rectangle(group.bounds));
+    }
+    index.place_all(
+        &footprints,
+        group.policy.allow_overlap,
+        group.policy.block_others,
+    )
+}
+
+fn collect(
+    layer_index: usize,
+    layer: &mut CollisionLayer<'_>,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    groups: &mut Vec<Group>,
+    compounds: &mut BTreeMap<(String, i64, i64), usize>,
+) {
+    let paint = layer_metadata(layer.style, view.zoom().level());
+    let visible = layer.style.is_visible_at(view.zoom().value()) && paint.circle_params[2] > 0.0;
+    for feature_index in 0..layer.data.features.len() {
+        let feature = &layer.data.features[feature_index];
+        let projected = visible
+            .then(|| projection::bounds(layer.data, feature, view, globe, &paint))
+            .flatten();
+        let Some(bounds) = projected else {
+            layer.opacity(feature_index, 0.0);
+            continue;
+        };
+        let Some(policy) = &layer.policy else {
+            continue;
+        };
+        let padding = policy.padding * f64::from(paint.paper_scale);
+        let bounds = bounds.padded(padding);
+        let shapes = feature_shapes(layer, feature, view, globe, &paint, padding);
+        if (policy.connector || policy.artwork || policy.component_bounds) && shapes.is_empty() {
+            layer.opacity(feature_index, 0.0);
+            continue;
+        }
+        let coords = layer.data.coords;
+        let factor = 2.0_f64.powi(24 - i32::from(u8::from(coords.z)));
+        let x = ((f64::from(coords.x) * 4096.0 + f64::from(feature.text_anchor.x)) * factor).round()
+            as i64;
+        let y = ((f64::from(coords.y) * 4096.0 + f64::from(feature.text_anchor.y)) * factor).round()
+            as i64;
+        let key = policy.group.as_ref().map(|name| (name.clone(), x, y));
+        if let Some(group) = key.as_ref().and_then(|key| compounds.get(key)).copied() {
+            groups[group].shapes.extend(shapes);
+            groups[group].has_body |= !policy.connector;
+            if !policy.connector && !policy.artwork && !policy.component_bounds {
+                groups[group].bounds.union(bounds);
+            }
+            groups[group].members.push((layer_index, feature_index));
+            continue;
+        }
+        if let Some(key) = key {
+            compounds.insert(key, groups.len());
+        }
+        groups.push(Group {
+            bounds: if policy.connector || policy.artwork || policy.component_bounds {
+                Bounds::empty()
+            } else {
+                bounds
+            },
+            shapes,
+            has_body: !policy.connector,
+            policy: policy.clone(),
+            members: vec![(layer_index, feature_index)],
+            order: (layer.style.index, x, y, feature.str.clone()),
+        });
+    }
+}
+
+fn feature_shapes(
+    layer: &CollisionLayer<'_>,
+    feature: &crate::sdf::Feature,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &crate::render::shaders::ShaderLayerMetadata,
+    padding: f64,
+) -> Vec<Footprint> {
+    let Some(policy) = &layer.policy else {
+        return Vec::new();
+    };
+    if policy.connector {
+        projection::connector_shapes(layer.data, feature, view, globe, paint, padding)
+            .unwrap_or_default()
+    } else if policy.artwork {
+        artwork::shapes(
+            layer.data,
+            feature,
+            layer.style,
+            view,
+            globe,
+            paint,
+            padding,
+        )
+        .unwrap_or_default()
+    } else if policy.component_bounds {
+        components::shapes(
+            layer.data,
+            feature,
+            view,
+            globe,
+            paint,
+            padding,
+            policy.text_ink,
+        )
+        .unwrap_or_default()
+    } else {
+        Vec::new()
+    }
+}
