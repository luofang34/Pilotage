+
+fn shape(labels: &[(String, f64, f64)]) -> (Buffer, Vec<Feature>) {
+    let atlas = FontAtlas::chart().expect("font atlas");
+    let (font, glyphs) = atlas.select(None).expect("default face");
+    let placements = vec![Placement::default(); labels.len()];
+    let shaped =
