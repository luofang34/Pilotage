+//! Per-feature endpoint exclusions retain geographic centers and screen-space radii.
+
+use geozero::error::GeozeroError;
+use serde::Deserialize;
+
+mod packed;
+
+use crate::{
+    coords::WorldTileCoords,
+    style::{expression::FeatureProperties, layer::StyleProperty},
+};
+
+/// Style metadata consumed by the line renderer; other layer kinds ignore it.
+pub const METADATA_KEY: &str = "maplibre:line-endpoint-disks";
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Descriptor {
+    start: [serde_json::Value; 3],
+    end: [serde_json::Value; 3],
+}
+
+/// Expressions select longitude, latitude and logical-pixel radius for each endpoint.
+#[derive(Clone, Debug)]
+pub struct EndpointDisks {
+    endpoints: [[StyleProperty<f64>; 3]; 2],
+    coords: WorldTileCoords,
+    packed: Option<packed::PackedDisks>,
+}
+
+impl EndpointDisks {
+    /// Parse the opt-in metadata while retaining malformed descriptor context.
+    pub fn parse(
+        value: &serde_json::Value,
+        coords: WorldTileCoords,
+    ) -> Result<Self, serde_json::Error> {
+        if value.get("encoding").is_some() {
+            return Ok(Self {
+                endpoints: std::array::from_fn(|_| {
+                    std::array::from_fn(|_| StyleProperty::parse(&serde_json::json!(0)))
+                }),
+                coords,
+                packed: Some(serde_json::from_value(value.clone())?),
+            });
+        }
+        let descriptor: Descriptor = serde_json::from_value(value.clone())?;
+        Ok(Self {
+            endpoints: [descriptor.start, descriptor.end]
+                .map(|values| values.map(|value| StyleProperty::parse(&value))),
+            coords,
+            packed: None,
+        })
+    }
+
+    /// Convert published centers into this source tile without moving a clipped line endpoint.
+    pub fn evaluate(
+        &self,
+        properties: &FeatureProperties,
+        zoom: f64,
+        anchors: [Option<[f32; 2]>; 2],
+    ) -> Result<[[f32; 4]; 2], GeozeroError> {
+        if let Some(packed) = &self.packed {
+            return packed.evaluate(properties, zoom, self.coords, anchors);
+        }
+        let mut result = [[0.0; 4]; 2];
+        for (index, expressions) in self.endpoints.iter().enumerate() {
+            let mut values = [0.0; 3];
+            for (value, expression) in values.iter_mut().zip(expressions) {
+                *value = expression
+                    .evaluate_for(properties, zoom)
+                    .ok_or_else(|| invalid("missing or nonnumeric endpoint value"))?;
+            }
+            let [longitude, latitude, radius] = values;
+            if values.iter().any(|value| !value.is_finite())
+                || longitude.abs() > 180.0
+                || latitude.abs() > 85.051_129
+                || !(0.0..=1024.0).contains(&radius)
+            {
+                return Err(invalid(
+                    "expected WGS 84 coordinates within Mercator and radius within 0–1024 pixels",
+                ));
+            }
+            let tiles = 2_f64.powi(i32::from(u8::from(self.coords.z)));
+            let world_x = (longitude + 180.0) / 360.0 * tiles;
+            let delta_x = world_x - self.coords.x as f64;
+            // Choose the world copy nearest this tile, including endpoints across the dateline.
+            let tile_x = delta_x - ((delta_x - 0.5) / tiles).round() * tiles;
+            let radians = latitude.to_radians();
+            let world_y = (1.0 - radians.tan().asinh() / std::f64::consts::PI) * 0.5 * tiles;
+            result[index] = [
+                (tile_x * 4096.0) as f32,
+                ((world_y - self.coords.y as f64) * 4096.0) as f32,
+                radius as f32,
+                0.0,
+            ];
+        }
+        Ok(result)
+    }
+}
+
+fn invalid(reason: &str) -> GeozeroError {
+    GeozeroError::Geometry(format!("{METADATA_KEY}: {reason}"))
+}
