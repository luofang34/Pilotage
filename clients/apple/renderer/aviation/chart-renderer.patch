+//! Render an installed chart style and save PNG frames for visual inspection.
+use maplibre::{
+    headless::{
+        create_headless_renderer_with_provider,
+        map::{process_tile_layers, HeadlessMap, ProcessedLayers},
+        HeadlessPlugin,
+    },
+    io::tile_sources::{source_layer_groups, source_tiles_for, TileKind},
+    plugin::Plugin,
+    projection::ProjectionType,
+    render::{settings::RendererSettings, RenderPlugin},
+    style::{sprite::resolve_sprite, Style},
+    vector::{DefaultVectorTransferables, VectorPlugin},
+};
+use std::{collections::BTreeSet, error::Error};
+
+#[path = "../src/aviation.rs"]
+mod aviation;
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn Error>> {
+    tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::WARN)
+        .init();
+    let path = std::env::args()
+        .nth(1)
+        .ok_or("chart style path is required")?;
+    let mut style: Style = serde_json::from_slice(&std::fs::read(path)?)?;
+    let provider = aviation::provider(&style)?;
+    let (kernel, renderer) = create_headless_renderer_with_provider(
+        1200,
+        900,
+        None,
+        RendererSettings::default(),
+        provider,
+    )
+    .await?;
+    resolve_sprite(&mut style, kernel.source_client()).await?;
+    let source_client = kernel.source_client().clone();
+    let groups = source_layer_groups(&style, TileKind::Vector);
+    let plugins: Vec<Box<dyn Plugin<_>>> = vec![
+        Box::new(RenderPlugin),
+        Box::new(maplibre::background::BackgroundPlugin),
+        Box::new(VectorPlugin::<DefaultVectorTransferables>::default()),
+        Box::new(maplibre::sdf::SdfPlugin::<DefaultVectorTransferables>::default()),
+        Box::new(HeadlessPlugin::new(true)),
+    ];
+    let mut map = HeadlessMap::new(style, renderer, kernel, plugins)?;
+    let mut coordinates = BTreeSet::new();
+    for tile in map.required_tile_coords()? {
+        coordinates.extend(source_tiles_for(tile, 0, Some(3), Some(8)));
+    }
+    let mut processed = ProcessedLayers::default();
+    let mut tile_count = 0;
+    for group in groups {
+        for coordinate in &coordinates {
+            let bytes = match source_client.fetch(coordinate, &group.source).await {
+                Ok(bytes) => bytes,
+                Err(error) if error.is_not_found() => continue,
+                Err(error) => return Err(error.into()),
+            };
+            tile_count += 1;
+            for layer in &group.layers {
+                processed.append(&mut process_tile_layers(
+                    &bytes,
+                    layer,
+                    *coordinate,
+                    ProjectionType::Globe,
+                )?);
+            }
+        }
+    }
+    tracing::warn!(
+        tile_count,
+        vector_layers = processed.vector.len(),
+        symbol_layers = processed.symbols.len(),
+        "Read local chart sources"
+    );
+    map.render_source_frames(processed, Vec::new(), 2)?;
+    Ok(())
+}
