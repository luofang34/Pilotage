+struct VertexOutput {
+    @location(1) v_data0: vec2<f32>,
+    @location(2) v_data1: vec3<f32>,
+    @location(4) horizon_distance: f32,
+    @location(5) @interpolate(flat) is_icon: u32,
+    @location(6) foreground: vec4<f32>,
+    @location(7) halo: vec4<f32>,
+    @location(8) halo_width: f32,
+    @builtin(position) position: vec4<f32>,
+};
+
+@group(1) @binding(0) var t_glyphs: texture_2d<f32>;
+@group(1) @binding(1) var s_glyphs: sampler;
+
+@group(3) @binding(0) var t_sprites: texture_2d<f32>;
+@group(3) @binding(1) var s_sprites: sampler;
+
+@fragment
+fn main(in: VertexOutput) -> @location(0) vec4<f32> {
+    let tex = in.v_data0 / vec2<f32>(textureDimensions(t_glyphs));
+    let distance = textureSample(t_glyphs, s_glyphs, tex).r;
+    let sprite = textureSample(t_sprites, s_sprites, in.v_data0 / vec2<f32>(textureDimensions(t_sprites)));
+    // Derivatives measure the SDF transition in screen pixels, independent of camera distance.
+    let edge_width = max(fwidth(distance), 1.0 / 255.0);
+    let alpha = smoothstep(0.75 - edge_width * 0.5, 0.75 + edge_width * 0.5, distance)
+        * in.v_data1.z;
+    if in.horizon_distance < 0.0 {
+        discard;
+    }
+    if in.is_icon == 2u {
+        let opacity = in.foreground.a * in.v_data1.z;
+        return vec4<f32>(in.foreground.rgb * opacity, opacity);
+    }
+    if in.is_icon != 0u {
+        return vec4<f32>(sprite.rgb * sprite.a, sprite.a) * in.v_data1.z;
+    }
+    let halo_threshold = 0.75 - in.halo_width / max(8.0 * in.v_data1.y / 24.0, 0.001);
+    let halo_coverage = smoothstep(halo_threshold - edge_width * 0.5,
+        halo_threshold + edge_width * 0.5, distance) * in.v_data1.z;
+    let foreground_alpha = alpha * in.foreground.a;
+    let halo_alpha = halo_coverage * in.halo.a * (1.0 - foreground_alpha);
+    return vec4<f32>(in.foreground.rgb * foreground_alpha + in.halo.rgb * halo_alpha,
+        foreground_alpha + halo_alpha);
+}
