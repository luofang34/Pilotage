+//! Bind the selected font's glyph positions to the legacy text shaper.
+
+use std::collections::HashMap;
+use widestring::U16String;
+
+use super::IconError;
+use crate::{
+    euclid::{Point2D, Rect, Size2D},
+    legacy::{
+        bidi::{apply_arabic_shaping, Char16},
+        buckets::symbol_bucket::SymbolBucketBuffer,
+        font_stack::FontStackHasher,
+        geometry_tile_data::{GeometryCoordinates, SymbolGeometryTileLayer},
+        glyph::{Glyph, GlyphDependencies, GlyphMap, GlyphMetrics, Glyphs},
+        glyph_atlas::{GlyphPosition, GlyphPositionMap, GlyphPositions},
+        image::ImageMap,
+        image_atlas::ImagePositions,
+        layout::{
+            layout::{BucketParameters, LayerTypeInfo, LayoutParameters},
+            symbol_feature::{SymbolGeometryTileFeature, VectorGeometryTileFeature},
+            symbol_layout::{FeatureIndex, LayerProperties, SymbolLayer, SymbolLayout},
+        },
+        style_types::SymbolLayoutProperties_Unevaluated,
+        tagged_string::TaggedString,
+        CanonicalTileID, MapMode, OverscaledTileID,
+    },
+    sdf::text::{Glyph as AtlasGlyph, GlyphSet},
+    style::text::placement::Placement,
+};
+
+pub(super) fn shape(
+    labels: &[(String, f64, f64)],
+    placements: &[Placement],
+    stack: &[String],
+    face: &GlyphSet,
+) -> Result<SymbolBucketBuffer, IconError> {
+    let layer_name = "text".to_owned();
+    let tile_id = OverscaledTileID {
+        canonical: CanonicalTileID { x: 0, y: 0, z: 0 },
+        overscaled_z: 0,
+    };
+    let parameters = BucketParameters {
+        tile_id,
+        mode: MapMode::Continuous,
+        pixel_ratio: 1.0,
+        layer_type: LayerTypeInfo,
+    };
+    let layer = SymbolGeometryTileLayer {
+        name: layer_name.clone(),
+        features: features(labels, placements, stack),
+    };
+    let properties = vec![LayerProperties {
+        id: layer_name.clone(),
+        layer: SymbolLayer {
+            layout: SymbolLayoutProperties_Unevaluated,
+        },
+    }];
+    let (glyphs, positions) = font_maps(face, stack);
+    let images = ImagePositions::new();
+    let mut dependencies = GlyphDependencies::new();
+    let mut layout = SymbolLayout::new(
+        &parameters,
+        &properties,
+        Box::new(layer),
+        &mut LayoutParameters {
+            bucket_parameters: &mut parameters.clone(),
+            glyph_dependencies: &mut dependencies,
+            image_dependencies: &mut Default::default(),
+            available_images: &mut Default::default(),
+        },
+    )
+    .ok_or_else(|| IconError::TextLayout {
+        layer: layer_name.clone(),
+        stage: "layout",
+    })?;
+    layout.prepare_symbols(&glyphs, &positions, &ImageMap::new(), &images);
+    let mut output = HashMap::new();
+    layout.create_bucket(
+        images,
+        Box::new(FeatureIndex),
+        &mut output,
+        false,
+        false,
+        &tile_id.canonical,
+    );
+    output
+        .remove(&layer_name)
+        .map(|buffer| buffer.bucket.text)
+        .ok_or(IconError::TextLayout {
+            layer: layer_name,
+            stage: "bucket",
+        })
+}
+
+fn features(
+    labels: &[(String, f64, f64)],
+    placements: &[Placement],
+    stack: &[String],
+) -> Vec<SymbolGeometryTileFeature> {
+    labels
+        .iter()
+        .zip(placements)
+        .map(|((text, x, y), placement)| {
+            let geometry = vec![GeometryCoordinates(vec![Point2D::new(
+                *x as i16, *y as i16,
+            )])];
+            let mut feature =
+                SymbolGeometryTileFeature::new(Box::new(VectorGeometryTileFeature { geometry }));
+            let mut tagged = TaggedString::default();
+            tagged.add_text_section(
+                &apply_arabic_shaping(&U16String::from(text.as_str())),
+                1.0,
+                stack.to_vec(),
+                None,
+            );
+            feature.formatted_text = Some(tagged);
+            feature.text_placement = placement.clone();
+            feature
+        })
+        .collect()
+}
+
+fn metrics(glyph: &AtlasGlyph) -> GlyphMetrics {
+    GlyphMetrics {
+        width: glyph.width,
+        height: glyph.height,
+        left: glyph.left_bearing,
+        top: glyph.top_bearing,
+        advance: glyph.h_advance,
+    }
+}
+
+fn font_maps(face: &GlyphSet, stack: &[String]) -> (GlyphMap, GlyphPositions) {
+    let stack = stack.to_vec();
+    let positions = GlyphPositionMap::from_iter(face.glyphs.iter().map(|(codepoint, glyph)| {
+        (
+            *codepoint as Char16,
+            GlyphPosition {
+                rect: Rect::new(
+                    Point2D::new(glyph.tex_origin_x as u16, glyph.tex_origin_y as u16),
+                    Size2D::new(
+                        glyph.buffered_dimensions().0 as u16,
+                        glyph.buffered_dimensions().1 as u16,
+                    ),
+                ),
+                metrics: metrics(glyph),
+            },
+        )
+    }));
+    let glyphs = Glyphs::from_iter(face.glyphs.iter().map(|(codepoint, glyph)| {
+        (
+            *codepoint as Char16,
+            Some(Glyph {
+                id: *codepoint as Char16,
+                bitmap: Default::default(),
+                metrics: metrics(glyph),
+            }),
+        )
+    }));
+    (
+        GlyphMap::from([(FontStackHasher::new(&stack), glyphs)]),
+        GlyphPositions::from([(FontStackHasher::new(&stack), positions)]),
+    )
+}
