+//! Tessellate chart frames and markings in calibrated symbol pixel space.
+
+use crate::{
+    render::shaders::ShaderSymbolVertexNew,
+    style::{expression::FeatureProperties, sprite::layout::paper_path::PaperPathLayout},
+};
+use lyon::{
+    math::point,
+    path::Path,
+    tessellation::{
+        BuffersBuilder, FillOptions, FillTessellator, FillVertex, LineCap, LineJoin, StrokeOptions,
+        StrokeTessellator, StrokeVertex, TessellationError, VertexBuffers,
+    },
+};
+use thiserror::Error;
+
+mod encoding;
+
+/// A malformed chart path must not disappear from an otherwise valid tile.
+#[derive(Debug, Error)]
+pub enum PaperPathError {
+    /// Path coordinates are not the declared JSON polyline format.
+    #[error("cannot decode paper path at {anchor:?}")]
+    Decode {
+        /// Geographic anchor in tile coordinates.
+        anchor: (f64, f64),
+        /// JSON syntax or type failure.
+        #[source]
+        source: serde_json::Error,
+    },
+    /// Dimensions or point counts exceed the supported bounded coordinate space.
+    #[error("invalid paper path at {anchor:?}: {reason}")]
+    Invalid {
+        /// Geographic anchor in tile coordinates.
+        anchor: (f64, f64),
+        /// Invalid path constraint.
+        reason: &'static str,
+    },
+    /// The stroke tessellator could not construct the supplied path.
+    #[error("cannot stroke paper path at {anchor:?}")]
+    Tessellate {
+        /// Geographic anchor in tile coordinates.
+        anchor: (f64, f64),
+        /// Underlying tessellation failure.
+        #[source]
+        source: TessellationError,
+    },
+    /// Appending path triangles would exceed the GPU index type.
+    #[error("paper path exceeds the index range after {vertices} vertices")]
+    IndexCapacity {
+        /// Existing vertex count.
+        vertices: usize,
+    },
+}
+
+struct PaperPath {
+    anchor: (f64, f64),
+    lines: Vec<Vec<[f32; 2]>>,
+    width: f32,
+    scale: f32,
+    fill: bool,
+    map_aligned: bool,
+    closed: bool,
+    rotation: f32,
+    offset: [f32; 2],
+}
+
+/// Collected paths and the first decoding failure for one symbol layer.
+#[derive(Default)]
+pub(super) struct PaperPaths {
+    paths: Vec<PaperPath>,
+    error: Option<PaperPathError>,
+}
+
+impl PaperPaths {
+    pub(super) fn collect(
+        &mut self,
+        layout: Option<&PaperPathLayout>,
+        anchor: Option<(f64, f64)>,
+        properties: &FeatureProperties,
+        zoom: f64,
+    ) {
+        let (Some(layout), Some(anchor)) = (layout, anchor) else {
+            return;
+        };
+        if self.error.is_some() {
+            return;
+        }
+        let Some(text) = layout
+            .path
+            .as_ref()
+            .and_then(|value| value.evaluate_for(properties, zoom))
+            .map(|value| value.0)
+            .filter(|text| !text.is_empty())
+        else {
+            return;
+        };
+        match decode(&text, anchor, layout) {
+            Ok(mut path) => {
+                match path_offset(layout, properties, zoom, anchor) {
+                    Ok(offset) => path.offset = offset,
+                    Err(error) => {
+                        self.error = Some(error);
+                        return;
+                    }
+                }
+                path.rotation = layout
+                    .rotate
+                    .as_ref()
+                    .and_then(|value| value.evaluate_for(properties, zoom))
+                    .filter(|value| value.is_finite())
+                    .unwrap_or(0.0)
+                    .rem_euclid(360.0)
+                    .to_radians() as f32;
+                self.paths.push(path);
+            }
+            Err(error) => self.error = Some(error),
+        }
+    }
+
+    pub(super) fn append(
+        &mut self,
+        buffer: &mut VertexBuffers<ShaderSymbolVertexNew, u32>,
+    ) -> Result<(), PaperPathError> {
+        if let Some(error) = self.error.take() {
+            return Err(error);
+        }
+        for path in &self.paths {
+            append_path(path, buffer)?;
+        }
+        Ok(())
+    }
+}
+
+fn path_offset(
+    layout: &PaperPathLayout,
+    properties: &FeatureProperties,
+    zoom: f64,
+    anchor: (f64, f64),
+) -> Result<[f32; 2], PaperPathError> {
+    let mut offset = [0.0; 2];
+    for (axis, expression) in [&layout.offset_x, &layout.offset_y].into_iter().enumerate() {
+        let Some(expression) = expression else {
+            continue;
+        };
+        let value = expression
+            .evaluate_for(properties, zoom)
+            .filter(|value| value.is_finite() && value.abs() <= 4096.0)
+            .ok_or(PaperPathError::Invalid {
+                anchor,
+                reason: "translation must be finite and within 4096 logical pixels",
+            })?;
+        offset[axis] = value as f32;
+    }
+    Ok(offset)
+}
+
+fn decode(
+    text: &str,
+    anchor: (f64, f64),
+    layout: &PaperPathLayout,
+) -> Result<PaperPath, PaperPathError> {
+    let invalid = |reason| PaperPathError::Invalid { anchor, reason };
+    if text.len() > 262_144 {
+        return Err(invalid("encoded path exceeds 256 KiB"));
+    }
+    if !layout.scale.is_finite()
+        || !(0.0..=16.0).contains(&layout.scale)
+        || !layout.stroke_width.is_finite()
+        || !(0.0..=32.0).contains(&layout.stroke_width)
+        || layout.stroke_width == 0.0
+    {
+        return Err(invalid(
+            "calibration or stroke width is outside its supported range",
+        ));
+    }
+    let lines: Vec<Vec<[f32; 2]>> = if let Some(encoded) = text.strip_prefix("p1:") {
+        encoding::decode(encoded).map_err(invalid)?
+    } else {
+        serde_json::from_str(text).map_err(|source| PaperPathError::Decode { anchor, source })?
+    };
+    let count: usize = lines.iter().map(Vec::len).sum();
+    if count > 8192
+        || lines
+            .iter()
+            .any(|line| line.len() < if layout.fill { 3 } else { 2 })
+    {
+        return Err(invalid(
+            "strokes need two points, fills need three, and total points cannot exceed 8192",
+        ));
+    }
+    if lines
+        .iter()
+        .flatten()
+        .flatten()
+        .any(|axis| !axis.is_finite() || axis.abs() > 4096.0)
+    {
+        return Err(invalid(
+            "coordinates must be finite and within 4096 logical pixels",
+        ));
+    }
+    Ok(PaperPath {
+        anchor,
+        lines,
+        width: layout.stroke_width,
+        scale: layout.scale,
+        fill: layout.fill,
+        map_aligned: layout.map_aligned,
+        closed: layout.closed,
+        rotation: 0.0,
+        offset: [0.0; 2],
+    })
+}
+
+fn append_path(
+    path: &PaperPath,
+    buffer: &mut VertexBuffers<ShaderSymbolVertexNew, u32>,
+) -> Result<(), PaperPathError> {
+    if path.scale == 0.0 {
+        return Ok(());
+    }
+    let mut builder = Path::builder();
+    for line in &path.lines {
+        builder.begin(point(line[0][0] * path.scale, line[0][1] * path.scale));
+        for coordinate in &line[1..] {
+            builder.line_to(point(
+                coordinate[0] * path.scale,
+                coordinate[1] * path.scale,
+            ));
+        }
+        builder.end(path.fill || path.closed);
+    }
+    let mut mesh = VertexBuffers::<[f32; 2], u32>::new();
+    let geometry = builder.build();
+    tessellate(path, &geometry, &mut mesh)?;
+    let capacity_error = || PaperPathError::IndexCapacity {
+        vertices: buffer.vertices.len(),
+    };
+    let base = u32::try_from(buffer.vertices.len()).map_err(|_| capacity_error())?;
+    let added = u32::try_from(mesh.vertices.len()).map_err(|_| capacity_error())?;
+    base.checked_add(added).ok_or_else(capacity_error)?;
+    let (sine, cosine) = path.rotation.sin_cos();
+    buffer
+        .vertices
+        .extend(mesh.vertices.into_iter().map(|[x, y]| {
+            let [x, y] = [
+                x + path.offset[0] * path.scale,
+                y + path.offset[1] * path.scale,
+            ];
+            ShaderSymbolVertexNew {
+                a_pos_offset: [
+                    path.anchor.0 as i32,
+                    path.anchor.1 as i32,
+                    ((x * cosine - y * sine) * 32.0).round() as i32,
+                    ((x * sine + y * cosine) * 32.0).round() as i32,
+                ],
+                a_data: [0, 0, 2, 0],
+                a_pixeloffset: [0, 0, 256, i32::from(!path.map_aligned)],
+            }
+        }));
+    buffer
+        .indices
+        .extend(mesh.indices.into_iter().map(|index| index + base));
+    Ok(())
+}
+
+fn tessellate(
+    path: &PaperPath,
+    geometry: &Path,
+    mesh: &mut VertexBuffers<[f32; 2], u32>,
+) -> Result<(), PaperPathError> {
+    let result = if path.fill {
+        FillTessellator::new().tessellate_path(
+            geometry,
+            &FillOptions::default(),
+            &mut BuffersBuilder::new(mesh, |vertex: FillVertex<'_>| vertex.position().to_array()),
+        )
+    } else {
+        StrokeTessellator::new().tessellate_path(
+            geometry,
+            &StrokeOptions::default()
+                .with_line_width(path.width * path.scale)
+                .with_line_cap(LineCap::Round)
+                .with_line_join(LineJoin::Round),
+            &mut BuffersBuilder::new(mesh, |vertex: StrokeVertex<'_, '_>| {
+                vertex.position().to_array()
+            }),
+        )
+    };
+    result.map_err(|source| PaperPathError::Tessellate {
+        anchor: path.anchor,
+        source,
+    })
+}
