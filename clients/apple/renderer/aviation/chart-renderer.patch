+//! A screen mask interrupts selected line layers without covering underlying chart detail.
+
+mod raster;
+
+pub(crate) struct AnnotationMask {
+    layout: wgpu::BindGroupLayout,
+    texture: wgpu::Texture,
+    group: wgpu::BindGroup,
+    dimensions: [u32; 2],
+    viewport: [f64; 2],
+    pixels: Vec<u8>,
+    uploaded: Vec<u8>,
+}
+
+impl AnnotationMask {
+    pub(crate) fn new(device: &wgpu::Device) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("annotation line clearance"),
+            entries: &[wgpu::BindGroupLayoutEntry {
+                binding: 0,
+                visibility: wgpu::ShaderStages::FRAGMENT,
+                ty: wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: false },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+                count: None,
+            }],
+        });
+        let (texture, group) = texture(device, &layout, [1, 1]);
+        Self {
+            layout,
+            texture,
+            group,
+            dimensions: [1, 1],
+            viewport: [1.0, 1.0],
+            pixels: vec![0],
+            uploaded: Vec::new(),
+        }
+    }
+    pub(crate) fn layout(&self) -> &wgpu::BindGroupLayout {
+        &self.layout
+    }
+    pub(crate) fn group(&self) -> &wgpu::BindGroup {
+        &self.group
+    }
+
+    pub(crate) fn begin(&mut self, device: &wgpu::Device, viewport: [f64; 2]) {
+        self.viewport = viewport;
+        let limit = device.limits().max_texture_dimension_2d.min(2048);
+        let dimensions = viewport.map(|axis| axis.ceil().clamp(1.0, f64::from(limit)) as u32);
+        if dimensions != self.dimensions {
+            (self.texture, self.group) = texture(device, &self.layout, dimensions);
+            self.dimensions = dimensions;
+            self.pixels
+                .resize(dimensions[0] as usize * dimensions[1] as usize, 0);
+            self.uploaded.clear();
+        }
+        self.pixels.fill(0);
+    }
+
+    pub(crate) fn include(&mut self, points: Vec<[f64; 2]>) {
+        let scale = [
+            f64::from(self.dimensions[0]) / self.viewport[0],
+            f64::from(self.dimensions[1]) / self.viewport[1],
+        ];
+        let points = points
+            .into_iter()
+            .map(|p| [p[0] * scale[0], p[1] * scale[1]])
+            .collect();
+        raster::paint(&mut self.pixels, self.dimensions, points);
+    }
+
+    pub(crate) fn upload(&mut self, queue: &wgpu::Queue) {
+        if self.pixels == self.uploaded {
+            return;
+        }
+        queue.write_texture(
+            wgpu::ImageCopyTexture {
+                texture: &self.texture,
+                mip_level: 0,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            &self.pixels,
+            wgpu::ImageDataLayout {
+                offset: 0,
+                bytes_per_row: Some(self.dimensions[0]),
+                rows_per_image: Some(self.dimensions[1]),
+            },
+            wgpu::Extent3d {
+                width: self.dimensions[0],
+                height: self.dimensions[1],
+                depth_or_array_layers: 1,
+            },
+        );
+        self.uploaded.clone_from(&self.pixels);
+    }
+}
+
+fn texture(
+    device: &wgpu::Device,
+    layout: &wgpu::BindGroupLayout,
+    dimensions: [u32; 2],
+) -> (wgpu::Texture, wgpu::BindGroup) {
+    let texture = device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("accepted annotation mask"),
+        size: wgpu::Extent3d {
+            width: dimensions[0],
+            height: dimensions[1],
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::R8Unorm,
+        usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+        view_formats: &[],
+    });
+    let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+    let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("annotation mask binding"),
+        layout,
+        entries: &[wgpu::BindGroupEntry {
+            binding: 0,
+            resource: wgpu::BindingResource::TextureView(&view),
+        }],
+    });
+    (texture, group)
+}
