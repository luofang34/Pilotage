+    } else {
+        super::upload_system::upload_system(context)
+    }
+}
+
+pub(super) fn queue(context: &mut MapContext) -> SystemResult {
+    if context.style.uses_chart_symbols() {
+        queue_system::queue_system(context)
+    } else {
+        super::queue_system::queue_system(context)
+    }
+}
