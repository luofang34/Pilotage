+}
+
+fn layer_layout() -> VertexBufferLayout {
+    VertexBufferLayout {
+        array_stride: std::mem::size_of::<ShaderLayerMetadata>() as u64,
+        step_mode: wgpu::VertexStepMode::Instance,
