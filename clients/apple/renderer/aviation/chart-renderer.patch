+}
+
+#[test]
+fn each_label_owns_its_actual_triangles_and_nonzero_bounds() {
+    let labels = vec![
+        ("ALPHA".into(), 1000.0, 2000.0),
+        ("BRAVO".into(), 2100.0, 1500.0),
+    ];
+    let (buffer, features) = shape(&labels);
+    assert_eq!(features.len(), 2);
+    let mut seen = vec![false; buffer.indices.len()];
+    for feature in features {
+        assert!(!feature.indices.is_empty());
+        assert!(feature.bbox.width() > 0.0 && feature.bbox.height() > 0.0);
+        for index in feature.indices {
+            assert!(!seen[index]);
+            seen[index] = true;
+            let vertex = &buffer.vertices[buffer.indices[index] as usize];
+            assert_eq!(
+                vertex.a_pos_offset[..2],
+                [feature.text_anchor.x as i32, feature.text_anchor.y as i32]
+            );
+        }
+    }
+    assert!(seen.into_iter().all(|seen| seen));
+}
