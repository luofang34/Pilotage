+#[test]
+fn production_half_grid_anchors_retain_the_interior_quantization() {
+    assert_eq!(anchor(8189.0, 4097.0, 8192.0), (4094.0, 2048.0));
+    assert_eq!(anchor(-3.0, -4095.0, 8192.0), (-2.0, -2048.0));
+}
