+//! Keep geometry storage within the native map's memory budget.
+use maplibre::render::{
+    settings::{BufferPoolSizes, RendererSettings},
+    ShaderVertex,
+};
+
+const VECTOR_VERTEX_BYTES: u64 = 192_000_000;
+
+pub(super) fn renderer_settings() -> RendererSettings {
+    let vertices = VECTOR_VERTEX_BYTES / std::mem::size_of::<ShaderVertex>() as u64;
+    RendererSettings {
+        texture_format: Some(super::SURFACE_FORMAT),
+        buffer_pools: BufferPoolSizes {
+            vertices,
+            indices: 24_000_000,
+            feature_metadata: vertices,
+            layer_metadata: 10 * 1024,
