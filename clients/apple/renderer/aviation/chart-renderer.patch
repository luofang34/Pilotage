+//! Authored text placement and paint carried with symbol layers.
+
+use crate::style::{expression::FeatureProperties, layer::StyleProperty};
+use serde::{Deserialize, Serialize};
+
+pub mod placement;
+use placement::{Offset, Placement};
+
+/// Symbol text properties used by shaping and rendering.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct TextStyle {
+    /// Ordered embedded font families; the first available face is selected.
+    #[serde(rename = "text-font", default, skip_serializing_if = "Option::is_none")]
+    pub font: Option<Vec<String>>,
+    /// Maximum row width in ems; zero preserves one unwrapped panel row.
+    #[serde(
+        rename = "text-max-width",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f64>::deserialize_or_none"
+    )]
+    pub max_width: Option<StyleProperty<f64>>,
+    /// Explicit screen-oriented text for point-anchored chart panels.
+    #[serde(
+        rename = "text-rotation-alignment",
+        default,
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub rotation_alignment: Option<String>,
+    /// Orientation of the text plane when the camera is pitched.
+    #[serde(
+        rename = "text-pitch-alignment",
+        default,
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub pitch_alignment: Option<String>,
+    /// Displacement in ems in the rotated text coordinate system.
+    #[serde(
+        rename = "text-offset",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<Offset>::deserialize_or_none"
+    )]
+    pub offset: Option<StyleProperty<Offset>>,
+    /// The label edge aligned with its geographic point.
+    #[serde(
+        rename = "text-anchor",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<String>::deserialize_or_none"
+    )]
+    pub anchor: Option<StyleProperty<String>>,
+    /// Clockwise rotation in degrees.
+    #[serde(
+        rename = "text-rotate",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f64>::deserialize_or_none"
+    )]
+    pub rotate: Option<StyleProperty<f64>>,
+    /// Text foreground color.
+    #[serde(
+        rename = "text-color",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<csscolorparser::Color>::deserialize_or_none"
+    )]
+    pub color: Option<StyleProperty<csscolorparser::Color>>,
+    /// Color outside glyph contours.
+    #[serde(
+        rename = "text-halo-color",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<csscolorparser::Color>::deserialize_or_none"
+    )]
+    pub halo_color: Option<StyleProperty<csscolorparser::Color>>,
+    /// Contour expansion in logical pixels.
+    #[serde(
+        rename = "text-halo-width",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f32>::deserialize_or_none"
+    )]
+    pub halo_width: Option<StyleProperty<f32>>,
+    /// Opacity of text and halo.
+    #[serde(
+        rename = "text-opacity",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f32>::deserialize_or_none"
+    )]
+    pub opacity: Option<StyleProperty<f32>>,
+}
+
+impl TextStyle {
+    /// Merge layout while retaining paint decoded from the paint object.
+    pub fn merge_layout(&mut self, value: &serde_json::Value) -> Result<(), serde_json::Error> {
+        let layout: Self = serde_json::from_value(value.clone())?;
+        self.font = layout.font.or(self.font.take());
+        self.max_width = layout.max_width.or(self.max_width.take());
+        self.offset = layout.offset.or(self.offset.take());
+        self.anchor = layout.anchor.or(self.anchor.take());
+        self.rotate = layout.rotate.or(self.rotate.take());
+        self.rotation_alignment = layout.rotation_alignment.or(self.rotation_alignment.take());
+        self.pitch_alignment = layout.pitch_alignment.or(self.pitch_alignment.take());
+        Ok(())
+    }
+
+    /// Explicit viewport text shares pixel coordinates with chart frames.
+    pub fn viewport_aligned(&self) -> bool {
+        self.rotation_alignment.as_deref() == Some("viewport")
+            && matches!(
+                self.pitch_alignment.as_deref(),
+                None | Some("auto" | "viewport")
+            )
+    }
+
+    /// Evaluate feature layout before the legacy shaper creates its quads.
+    pub fn placement(&self, properties: &FeatureProperties, zoom: f64) -> Placement {
+        Placement {
+            max_width: self
+                .max_width
+                .as_ref()
+                .and_then(|v| v.evaluate_for(properties, zoom))
+                .filter(|value| value.is_finite() && *value >= 0.0)
+                .unwrap_or(10.0),
+            offset: self
+                .offset
+                .as_ref()
+                .and_then(|v| v.evaluate_for(properties, zoom))
+                .map(|v| v.0)
+                .filter(|v| v.iter().all(|x| x.is_finite()))
+                .unwrap_or([0.0; 2]),
+            anchor: placement::anchor(
+                self.anchor
+                    .as_ref()
+                    .and_then(|v| v.evaluate_for(properties, zoom))
+                    .as_deref()
+                    .unwrap_or("center"),
+            ),
+            rotate: self
+                .rotate
+                .as_ref()
+                .and_then(|v| v.evaluate_for(properties, zoom))
+                .filter(|v| v.is_finite())
+                .unwrap_or(0.0),
+        }
+    }
+
+    /// Layer-wide text and halo paint evaluated at the active camera zoom.
+    pub fn paint(&self, zoom: f64) -> ([f32; 4], [f32; 4], f32, f32) {
+        let foreground = color(&self.color, zoom, [0.0, 0.0, 0.0, 1.0]);
+        let halo = color(&self.halo_color, zoom, [0.0; 4]);
+        let width = number(&self.halo_width, zoom, 0.0).max(0.0);
+        let opacity = number(&self.opacity, zoom, 1.0).clamp(0.0, 1.0);
+        (foreground, halo, width, opacity)
+    }
+}
+
+fn number(property: &Option<StyleProperty<f32>>, zoom: f64, default: f32) -> f32 {
+    property
+        .as_ref()
+        .and_then(|v| v.evaluate_at_zoom(zoom))
+        .filter(|v| v.is_finite())
+        .unwrap_or(default)
+}
+
+fn color(
+    property: &Option<StyleProperty<csscolorparser::Color>>,
+    zoom: f64,
+    default: [f32; 4],
+) -> [f32; 4] {
+    property
+        .as_ref()
+        .and_then(|v| v.evaluate_at_zoom(zoom))
+        .map(|c| [c.r as f32, c.g as f32, c.b as f32, c.a as f32])
+        .unwrap_or(default)
+}
