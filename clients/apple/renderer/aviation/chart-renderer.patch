+        array_stride: std::mem::size_of::<ShaderTileMetadata>() as u64,
+        step_mode: wgpu::VertexStepMode::Instance,
+        attributes: vec![
+            attribute(0, wgpu::VertexFormat::Float32x4, 4),
+            attribute(
+                1 * wgpu::VertexFormat::Float32x4.size(),
