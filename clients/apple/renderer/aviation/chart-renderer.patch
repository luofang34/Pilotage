+//! Embedded font faces share one GPU texture while retaining separate glyph identities.
+
+use std::collections::BTreeMap;
+
+use thiserror::Error;
+
+use crate::sdf::text::GlyphSet;
+
+const DEFAULT_FONT: &str = "Klokantech Noto Sans Regular";
+
+/// Embedded glyph data or an authored font stack could not be resolved.
+#[derive(Debug, Error)]
+pub enum FontError {
+    /// A named resource contains invalid protobuf data.
+    #[error("cannot decode embedded font {name}: {source}")]
+    Decode {
+        /// Font identity carried by the resource.
+        name: String,
+        /// Protobuf decoding failure.
+        #[source]
+        source: prost::DecodeError,
+    },
+    /// No requested family is embedded in this renderer.
+    #[error("no embedded face is available for font stack {names:?}")]
+    Missing {
+        /// Families in authored fallback order.
+        names: Vec<String>,
+    },
+}
+
+/// Packed texture and per-family lookup tables use identical coordinates in workers and GPU upload.
+pub struct FontAtlas {
+    faces: BTreeMap<String, GlyphSet>,
+    texture_bytes: Vec<u8>,
+    texture_dimensions: (usize, usize),
+}
+
+impl FontAtlas {
+    /// Decode the pinned chart resources without accessing mutable global state.
+    pub fn chart() -> Result<Self, FontError> {
+        Self::from_resources(&[
+            (
+                DEFAULT_FONT,
+                include_bytes!("../../../../data/chart-glyphs.pbf"),
+            ),
+            (
+                "Futura Medium",
+                include_bytes!("../../../../data/futura-medium.pbf"),
+            ),
+            (
+                "Futura Medium Italic",
+                include_bytes!("../../../../data/futura-mediumitalic.pbf"),
+            ),
+        ])
+    }
+
+    fn from_resources(resources: &[(&str, &[u8])]) -> Result<Self, FontError> {
+        let mut faces = BTreeMap::new();
+        let mut height = 0;
+        let mut width = 0;
+        for (name, data) in resources {
+            let mut face = GlyphSet::try_from(*data).map_err(|source| FontError::Decode {
+                name: (*name).to_owned(),
+                source,
+            })?;
+            for glyph in face.glyphs.values_mut() {
+                glyph.tex_origin_y += height as u32;
+            }
+            let size = face.get_texture_dimensions();
+            width = width.max(size.0);
+            height += size.1 + 2;
+            faces.insert((*name).to_owned(), face);
+        }
+        let mut texture_bytes = vec![0; width * height];
+        let mut y = 0;
+        for (name, _) in resources {
+            let face = faces.get(*name).ok_or_else(|| FontError::Missing {
+                names: vec![(*name).to_owned()],
+            })?;
+            let size = face.get_texture_dimensions();
+            for row in 0..size.1 {
+                texture_bytes[(y + row) * width..(y + row) * width + size.0]
+                    .copy_from_slice(&face.get_texture_bytes()[row * size.0..(row + 1) * size.0]);
+            }
+            y += size.1 + 2;
+        }
+        Ok(Self {
+            faces,
+            texture_bytes,
+            texture_dimensions: (width, height),
+        })
+    }
+
+    /// Select the first embedded face in authored order; omitted stacks retain the default face.
+    pub fn select(&self, names: Option<&[String]>) -> Result<(&str, &GlyphSet), FontError> {
+        let defaults = [DEFAULT_FONT.to_owned()];
+        let names = names.unwrap_or(&defaults);
+        for name in names {
+            // These names are accepted by the bundled styles that use the default Noto resource.
+            let key = match name.as_str() {
+                "Open Sans Regular" | "Open Sans Semibold" | "Arial Unicode MS Regular" => {
+                    DEFAULT_FONT
+                }
+                other => other,
+            };
+            if let Some((key, face)) = self.faces.get_key_value(key) {
+                return Ok((key, face));
+            }
+        }
+        Err(FontError::Missing {
+            names: names.to_vec(),
+        })
+    }
+
+    /// Dimensions used by the GPU texture binding.
+    pub fn get_texture_dimensions(&self) -> (usize, usize) {
+        self.texture_dimensions
+    }
+
+    /// Row-major eight-bit signed-distance samples for all embedded faces.
+    pub fn get_texture_bytes(&self) -> &[u8] {
+        &self.texture_bytes
+    }
+}
