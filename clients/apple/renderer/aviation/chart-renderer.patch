+//! Convex footprints preserve empty space outside artwork and beside diagonal leaders.
+
+use super::Bounds;
+
+#[derive(Clone)]
+pub(in crate::sdf::chart::collision_system) enum Footprint {
+    Rectangle(Bounds),
+    Triangle { points: [[f64; 2]; 3], padding: f64 },
+    Polygon { points: Vec<[f64; 2]>, padding: f64 },
+}
+
+impl Footprint {
+    pub(super) fn bounds(&self) -> Bounds {
+        match self {
+            Self::Rectangle(bounds) => *bounds,
+            Self::Triangle { padding, .. } | Self::Polygon { padding, .. } => {
+                let mut storage = [[0.0; 2]; 4];
+                let points = self.vertices(&mut storage);
+                let mut bounds = Bounds::empty();
+                for point in points {
+                    bounds.include(*point);
+                }
+                bounds.padded(*padding)
+            }
+        }
+    }
+
+    pub(super) fn intersects(&self, other: &Self) -> bool {
+        if !self.bounds().intersects(other.bounds()) {
+            return false;
+        }
+        if matches!((self, other), (Self::Rectangle(_), Self::Rectangle(_))) {
+            return true;
+        }
+        let mut a_storage = [[0.0; 2]; 4];
+        let mut b_storage = [[0.0; 2]; 4];
+        let a = self.vertices(&mut a_storage);
+        let b = other.vertices(&mut b_storage);
+        let padding = self.padding() + other.padding();
+        for polygon in [a, b] {
+            for index in 0..polygon.len() {
+                let p = polygon[index];
+                let q = polygon[(index + 1) % polygon.len()];
+                let axis = [p[1] - q[1], q[0] - p[0]];
+                let length = axis[0].hypot(axis[1]);
+                if length == 0.0 {
+                    continue;
+                }
+                let (amin, amax) = interval(a, axis);
+                let (bmin, bmax) = interval(b, axis);
+                if amax + padding * length <= bmin || bmax + padding * length <= amin {
+                    return false;
+                }
+            }
+        }
+        true
+    }
+
+    fn vertices<'a>(&'a self, storage: &'a mut [[f64; 2]; 4]) -> &'a [[f64; 2]] {
+        match self {
+            Self::Rectangle(Bounds([x0, y0, x1, y1])) => {
+                *storage = [[*x0, *y0], [*x1, *y0], [*x1, *y1], [*x0, *y1]];
+                storage
+            }
+            Self::Triangle { points, .. } => points,
+            Self::Polygon { points, .. } => points,
+        }
+    }
+
+    fn padding(&self) -> f64 {
+        match self {
+            Self::Rectangle(_) => 0.0,
+            Self::Triangle { padding, .. } | Self::Polygon { padding, .. } => *padding,
+        }
+    }
+}
+
+fn interval(points: &[[f64; 2]], axis: [f64; 2]) -> (f64, f64) {
+    points
+        .iter()
+        .fold((f64::INFINITY, f64::NEG_INFINITY), |(min, max), point| {
+            let value = point[0] * axis[0] + point[1] * axis[1];
+            (min.min(value), max.max(value))
+        })
+}
