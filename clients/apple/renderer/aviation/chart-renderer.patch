+fn labels_beyond_a_u16_segment_use_global_vertex_indices() {
+    let labels: Vec<_> = (0..1800)
+        .map(|i| {
+            (
+                "ABCDEFGHIJ".into(),
+                f64::from(i % 40 * 80),
+                f64::from(i / 40 * 80),
+            )
+        })
+        .collect();
+    let (buffer, features) = shape(&labels);
+    assert!(buffer.vertices.len() > usize::from(u16::MAX));
+    assert!(buffer
+        .indices
+        .iter()
+        .any(|index| *index > u32::from(u16::MAX)));
+    assert_eq!(features.len(), labels.len());
+    for feature in features {
+        for index in feature.indices {
+            let vertex = &buffer.vertices[buffer.indices[index] as usize];
+            assert_eq!(
+                vertex.a_pos_offset[..2],
+                [feature.text_anchor.x as i32, feature.text_anchor.y as i32]
+            );
+        }
+    }
+}
