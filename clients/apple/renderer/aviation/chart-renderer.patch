+    regular: super::collision_system::CollisionSystem,
+    chart: collision_system::CollisionSystem,
+}
+impl Default for CollisionDispatch {
+    fn default() -> Self {
+        Self {
+            regular: super::collision_system::CollisionSystem::new(),
+            chart: collision_system::CollisionSystem::new(),
+        }
+    }
+}
+impl System for CollisionDispatch {
+    fn name(&self) -> Cow<'static, str> {
+        "symbol_collision".into()
+    }
+    fn run(&mut self, context: &mut MapContext) -> SystemResult {
+        if context.style.uses_chart_symbols() {
+            self.chart.run(context)
+        } else {
+            self.regular.run(context)
+        }
+    }
+}
