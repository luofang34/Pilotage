+//! Construct display-only zigzags without changing the tile's route coordinates.
+
+use crate::{
+    coords::WorldTileCoords,
+    style::{
+        layer::StyleLayer,
+        zigzag::{ZigzagError, ZigzagSpec},
+    },
+};
+
+#[derive(Clone, Copy)]
+pub(crate) struct Zigzag {
+    origin: [f64; 2],
+    period: f64,
+    height: f64,
+}
+
+impl Zigzag {
+    pub(crate) fn from_layer(layer: &StyleLayer, coords: WorldTileCoords) -> Option<Self> {
+        let metadata = layer.metadata.as_ref()?;
+        let spec: ZigzagSpec =
+            serde_json::from_value(metadata.get("maplibre:line-zigzag")?.clone()).ok()?;
+        let tile_zoom = f64::from(u8::from(coords.z));
+        let world_tiles = 2.0_f64.powf(tile_zoom);
+        let reference = metadata
+            .get("maplibre:paper-scale")
+            .and_then(|m| m.get("reference_zoom"))
+            .and_then(|z| z.as_f64());
+        let pixels_to_tile = if let Some(zoom) = reference {
+            8.0 * 2.0_f64.powf(tile_zoom - zoom)
+        } else {
+            let mercator_y = (f64::from(coords.y) + 0.5) / world_tiles;
+            let latitude_cosine = 1.0 / (std::f64::consts::PI * (1.0 - 2.0 * mercator_y)).cosh();
+            let nm_per_unit = std::f64::consts::TAU * 6378137.0 * latitude_cosine
+                / (1852.0 * world_tiles * 4096.0);
+            spec.paper_nm_per_in / (96.0 * nm_per_unit)
+        };
+        Some(Self {
+            origin: [f64::from(coords.x) * 4096.0, f64::from(coords.y) * 4096.0],
+            period: spec.period_px * pixels_to_tile,
+            height: spec.height_px * pixels_to_tile,
+        })
+    }
+
+    pub(crate) fn segment(
+        &self,
+        start: [f32; 2],
+        end: [f32; 2],
+    ) -> Result<Vec<[f32; 2]>, ZigzagError> {
+        let a = start.map(f64::from);
+        let b = end.map(f64::from);
+        let delta = [b[0] - a[0], b[1] - a[1]];
+        let length = delta[0].hypot(delta[1]);
+        if length < f64::EPSILON {
+            return Ok(vec![start]);
+        }
+        let sign = if delta[0] < 0.0 || (delta[0] == 0.0 && delta[1] < 0.0) {
+            -1.0
+        } else {
+            1.0
+        };
+        let tangent = [delta[0] / length * sign, delta[1] / length * sign];
+        let along = |p: [f64; 2]| {
+            (p[0] + self.origin[0]) * tangent[0] + (p[1] + self.origin[1]) * tangent[1]
+        };
+        let first = along(a);
+        let last = along(b);
+        let step = self.period / 2.0;
+        let low = ((first.min(last) - self.period / 4.0) / step).floor() as i64 + 1;
+        let high = ((first.max(last) - self.period / 4.0) / step).ceil() as i64;
+        let vertices = high.saturating_sub(low) as usize + 2;
+        if vertices > 8192 {
+            return Err(ZigzagError::Capacity { vertices });
+        }
+        let mut positions: Vec<f64> = (low..high)
+            .map(|i| (i as f64 * step + self.period / 4.0 - first) / (last - first))
+            .filter(|t| *t > 0.0 && *t < 1.0)
+            .collect();
+        positions.sort_by(f64::total_cmp);
+        positions.insert(0, 0.0);
+        positions.push(1.0);
+        Ok(positions
+            .into_iter()
+            .map(|t| {
+                let point = [a[0] + delta[0] * t, a[1] + delta[1] * t];
+                let phase = (along(point) / self.period).rem_euclid(1.0);
+                let wave = 1.0 - 4.0 * ((phase - 0.25).rem_euclid(1.0) - 0.5).abs();
+                let offset = wave * self.height / 2.0;
+                [
+                    (point[0] - tangent[1] * offset) as f32,
+                    (point[1] + tangent[0] * offset) as f32,
+                ]
+            })
+            .collect())
+    }
+}
