+//! Follow the textured quad's triangle split and perspective when projecting sprite envelopes.
+
+use super::{placement::Footprint, projection};
+use crate::{
+    projection::globe::camera::GlobeCameraState,
+    render::{shaders::ShaderLayerMetadata, view_state::ViewState},
+    sdf::{Feature, SymbolLayerData},
+    style::{layer::LayerPaint, layer::StyleLayer, sprite::SpriteEntry},
+};
+
+pub(super) fn shapes(
+    layer: &SymbolLayerData,
+    feature: &Feature,
+    style: &StyleLayer,
+    view: &ViewState,
+    globe: Option<&GlobeCameraState>,
+    paint: &ShaderLayerMetadata,
+    padding: f64,
+) -> Option<Vec<Footprint>> {
+    let Some(LayerPaint::Symbol(symbol)) = &style.paint else {
+        return None;
+    };
+    let buffer = &layer.new_buffer.buffer;
+    let indices = buffer.indices.get(feature.indices.clone())?;
+    if indices.len() % 6 != 0 {
+        return None;
+    }
+    let mut shapes = Vec::new();
+    for quad in indices.chunks_exact(6) {
+        if quad[0] != quad[3] || quad[2] != quad[4] {
+            return None;
+        }
+        let mut screen = [([0.0; 2], 1.0); 4];
+        let first = buffer.vertices.get(quad[0] as usize)?;
+        let entry = symbol
+            .icon
+            .index
+            .values()
+            .find(|entry| entry.x == first.a_data[0] && entry.y == first.a_data[1])?;
+        for (i, vertex_index) in [quad[0], quad[1], quad[2], quad[5]].into_iter().enumerate() {
+            let vertex = buffer.vertices.get(vertex_index as usize)?;
+            let expected = [
+                entry.x + if i == 1 || i == 2 { entry.width } else { 0 },
+                entry.y + if i >= 2 { entry.height } else { 0 },
+            ];
+            if vertex.a_data[2] != 0 || [vertex.a_data[0], vertex.a_data[1]] != expected {
+                return None;
+            }
+            screen[i] = projection::vertex_projection(vertex, layer.coords, view, globe, paint)?;
+        }
+        shapes.extend(project_hull(entry, screen, padding)?);
+    }
+    (!shapes.is_empty()).then_some(shapes)
+}
+
+fn project_hull(
+    entry: &SpriteEntry,
+    screen: [([f64; 2], f64); 4],
+    padding: f64,
+) -> Option<Vec<Footprint>> {
+    let normalized: Vec<_> = entry
+        .collision_hull
+        .iter()
+        .map(|p| {
+            [
+                f64::from(p[0]) / f64::from(entry.width),
+                f64::from(p[1]) / f64::from(entry.height),
+            ]
+        })
+        .collect();
+    let mut result = Vec::new();
+    for upper in [true, false] {
+        let clipped = clip(&normalized, upper);
+        if clipped.len() < 3 {
+            continue;
+        }
+        let points: Vec<_> = clipped
+            .into_iter()
+            .map(|[u, v]| {
+                let (weights, triangle) = if upper {
+                    ([1.0 - u, u - v, v], [screen[0], screen[1], screen[2]])
+                } else {
+                    ([1.0 - v, u, v - u], [screen[0], screen[2], screen[3]])
+                };
+                let w: f64 = weights.iter().zip(triangle).map(|(b, (_, w))| b * w).sum();
+                std::array::from_fn(|axis| {
+                    weights
+                        .iter()
+                        .zip(triangle)
+                        .map(|(b, (point, w))| b * w * point[axis])
+                        .sum::<f64>()
+                        / w
+                })
+            })
+            .collect();
+        if points.iter().flatten().any(|value| !value.is_finite()) {
+            return None;
+        }
+        result.push(Footprint::Polygon { points, padding });
+    }
+    (!result.is_empty()).then_some(result)
+}
+
+fn clip(points: &[[f64; 2]], upper: bool) -> Vec<[f64; 2]> {
+    let mut result = Vec::new();
+    for (i, a) in points.iter().enumerate() {
+        let b = points[(i + 1) % points.len()];
+        let da = (a[0] - a[1]) * if upper { 1.0 } else { -1.0 };
+        let db = (b[0] - b[1]) * if upper { 1.0 } else { -1.0 };
+        if da >= 0.0 {
+            result.push(*a);
+        }
+        if (da < 0.0 && db > 0.0) || (da > 0.0 && db < 0.0) {
+            let t = da / (da - db);
+            let diagonal = a[0] + t * (b[0] - a[0]);
+            result.push([diagonal, diagonal]);
+        }
+    }
+    result
+}
