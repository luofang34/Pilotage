+//! Opt-in collision policy for symbols with authored placement and priority.
+
+use super::layer::StyleLayer;
+use serde::Deserialize;
+use std::collections::HashMap;
+
+/// Placement priority and ownership for a symbol layer.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct CollisionPolicy {
+    /// Higher values are placed first, independent of tile arrival order.
+    pub priority: i32,
+    /// Components with the same group and geographic anchor form one label.
+    pub group: Option<String>,
+    /// Authored mandatory symbols remain visible when their boxes overlap.
+    pub allow_overlap: bool,
+    /// Reserve this symbol's bounds against lower-priority labels.
+    pub block_others: bool,
+    /// Extra logical pixels outside the glyph bounds.
+    pub padding: f64,
+    /// This accepted annotation may interrupt opt-in route layers.
+    pub clear_lines: bool,
+    /// A connector shares its group's visibility and reserves its triangle mesh separately.
+    pub connector: bool,
+    /// Reserve the sprite artwork envelope instead of its transparent canvas.
+    pub artwork: bool,
+    /// Reserve each symbol's projected envelope, independently or inside its group.
+    pub component_bounds: bool,
+    /// Exclude transparent glyph sampling borders from unhaloed text placement and line masks.
+    pub text_ink: bool,
+}
+
+impl Default for CollisionPolicy {
+    fn default() -> Self {
+        Self {
+            priority: 0,
+            group: None,
+            allow_overlap: false,
+            block_others: true,
+            padding: 0.5,
+            clear_lines: false,
+            connector: false,
+            artwork: false,
+            component_bounds: false,
+            text_ink: false,
+        }
+    }
+}
+
+/// A malformed policy is rejected while loading the style.
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum CollisionError {
+    /// The policy cannot be decoded.
+    #[error("invalid collision policy in layer {layer}")]
+    Decode {
+        layer: String,
+        #[source]
+        source: serde_json::Error,
+    },
+    /// Padding cannot describe a finite screen rectangle.
+    #[error("collision padding must be finite and between 0 and 32 in layer {layer}")]
+    Padding { layer: String },
+    /// A connector must disappear when its associated label is absent.
+    #[error("collision connector requires a group in layer {layer}")]
+    Connector { layer: String },
+    /// Sprite artwork and path connectors require different geometry.
+    #[error("collision artwork cannot also be a connector in layer {layer}")]
+    ArtworkConnector { layer: String },
+    /// Component envelopes require ordinary symbol geometry and valid optional ownership.
+    #[error(
+        "component bounds require ordinary symbols and a nonempty group when specified in layer {layer}"
+    )]
+    ComponentBounds { layer: String },
+    /// Glyph ink projection requires a component footprint.
+    #[error("text ink bounds require component bounds in layer {layer}")]
+    TextInk { layer: String },
+}
+
+pub(crate) fn validate(
+    metadata: Option<&HashMap<String, serde_json::Value>>,
+    layer: &str,
+) -> Result<(), CollisionError> {
+    let Some(value) = metadata.and_then(|m| m.get("maplibre:collision")) else {
+        return Ok(());
+    };
+    let policy: CollisionPolicy =
+        serde_json::from_value(value.clone()).map_err(|source| CollisionError::Decode {
+            layer: layer.into(),
+            source,
+        })?;
+    if !policy.padding.is_finite() || !(0.0..=32.0).contains(&policy.padding) {
+        return Err(CollisionError::Padding {
+            layer: layer.into(),
+        });
+    }
+    if policy.connector && policy.group.as_deref().is_none_or(str::is_empty) {
+        return Err(CollisionError::Connector {
+            layer: layer.into(),
+        });
+    }
+    if policy.artwork && policy.connector {
+        return Err(CollisionError::ArtworkConnector {
+            layer: layer.into(),
+        });
+    }
+    if policy.component_bounds
+        && (policy.group.as_deref().is_some_and(str::is_empty)
+            || policy.connector
+            || policy.artwork)
+    {
+        return Err(CollisionError::ComponentBounds {
+            layer: layer.into(),
+        });
+    }
+    if policy.text_ink && !policy.component_bounds {
+        return Err(CollisionError::TextInk {
+            layer: layer.into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn policy(layer: &StyleLayer) -> Option<CollisionPolicy> {
+    layer
+        .metadata
+        .as_ref()?
+        .get("maplibre:collision")
+        .and_then(|value| serde_json::from_value(value.clone()).ok())
+}
