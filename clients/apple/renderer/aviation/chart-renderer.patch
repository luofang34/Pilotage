+//! Icon layout properties carried with symbol layers.
+
+use super::SpriteIndex;
+use crate::style::layer::{StyleProperty, TextField};
+use serde::{Deserialize, Serialize};
+use std::sync::Arc;
+
+pub mod paper_path;
+pub mod placement;
+use placement::{IconOffset, IconPlacement};
+
+/// Sprite selection and sizing for a symbol layer.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct IconLayout {
+    /// Literal, token template or feature expression selecting a sprite.
+    #[serde(
+        rename = "icon-image",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<TextField>::deserialize_or_none"
+    )]
+    pub image: Option<StyleProperty<TextField>>,
+    /// Scale of the sprite's logical dimensions.
+    #[serde(
+        rename = "icon-size",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f32>::deserialize_f32_or_none"
+    )]
+    pub size: Option<StyleProperty<f32>>,
+    /// Clockwise rotation in degrees around the symbol's geographic anchor.
+    #[serde(
+        rename = "icon-rotate",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<f32>::deserialize_f32_or_none"
+    )]
+    pub rotate: Option<StyleProperty<f32>>,
+    /// Sprite edge that meets its geographic point before rotation.
+    #[serde(
+        rename = "icon-anchor",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<String>::deserialize_or_none"
+    )]
+    pub anchor: Option<StyleProperty<String>>,
+    /// Displacement in logical sprite pixels before icon-size and rotation.
+    #[serde(
+        rename = "icon-offset",
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "StyleProperty::<IconOffset>::deserialize_or_none"
+    )]
+    pub offset: Option<StyleProperty<IconOffset>>,
+    /// Icon orientation relative to the map or viewport.
+    #[serde(
+        rename = "icon-rotation-alignment",
+        default,
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub rotation_alignment: Option<String>,
+    /// Icon plane relative to the map or viewport.
+    #[serde(
+        rename = "icon-pitch-alignment",
+        default,
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub pitch_alignment: Option<String>,
+    /// Content-fitted chart paths supplied in symbol metadata.
+    #[serde(
+        rename = "maplibre:symbol-path",
+        default,
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub paper_path: Option<paper_path::PaperPathLayout>,
+    /// Resolved atlas rectangles; worker messages exclude the image itself.
+    #[serde(
+        rename = "maplibre:sprite-index",
+        default,
+        skip_serializing_if = "is_empty"
+    )]
+    pub index: Arc<SpriteIndex>,
+}
+
+fn is_empty(index: &Arc<SpriteIndex>) -> bool {
+    index.is_empty()
+}
+
+impl IconLayout {
+    /// Merge authored layout properties while retaining the resolved worker index.
+    pub fn merge_layout(&mut self, value: &serde_json::Value) -> Result<(), serde_json::Error> {
+        let layout: Self = serde_json::from_value(value.clone())?;
+        if layout.image.is_some() {
+            self.image = layout.image;
+        }
+        if layout.size.is_some() {
+            self.size = layout.size;
+        }
+        if layout.rotate.is_some() {
+            self.rotate = layout.rotate;
+        }
+        self.anchor = layout.anchor.or(self.anchor.take());
+        self.offset = layout.offset.or(self.offset.take());
+        self.rotation_alignment = layout.rotation_alignment.or(self.rotation_alignment.take());
+        self.pitch_alignment = layout.pitch_alignment.or(self.pitch_alignment.take());
+        self.paper_path = layout.paper_path.or(self.paper_path.take());
+        Ok(())
+    }
+
+    /// Point symbols with viewport orientation and pitch retain their screen dimensions.
+    pub fn viewport_aligned(&self) -> bool {
+        matches!(
+            self.rotation_alignment.as_deref(),
+            None | Some("auto" | "viewport")
+        ) && matches!(
+            self.pitch_alignment.as_deref(),
+            None | Some("auto" | "viewport")
+        )
+    }
+
+    /// Evaluate feature placement in the sprite's unrotated logical pixel space.
+    pub fn placement(
+        &self,
+        properties: &crate::style::expression::FeatureProperties,
+        zoom: f64,
+    ) -> IconPlacement {
+        IconPlacement {
+            anchor: placement::anchor(
+                self.anchor
+                    .as_ref()
+                    .and_then(|value| value.evaluate_for(properties, zoom))
+                    .as_deref()
+                    .unwrap_or("center"),
+            ),
+            offset: self
+                .offset
+                .as_ref()
+                .and_then(|value| value.evaluate_for(properties, zoom))
+                .map(|value| value.0)
+                .filter(|value| value.iter().all(|axis| axis.is_finite()))
+                .unwrap_or([0.0; 2]),
+        }
+    }
+
+    /// The layer-wide scale at the current camera zoom.
+    pub fn size_at_zoom(&self, zoom: f64) -> f32 {
+        self.size
+            .as_ref()
+            .filter(|size| size.is_feature_constant())
+            .and_then(|size| size.evaluate_at_zoom(zoom))
+            .filter(|size| size.is_finite() && *size >= 0.0)
+            .unwrap_or(1.0)
+    }
+}
