+//! Sprite assets resolved once before symbol tiles are processed.
+
+use std::{collections::BTreeMap, sync::Arc};
+
+use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+use crate::io::source_client::{HttpClient, SourceClient, SourceFetchError};
+use crate::style::{layer::LayerPaint, Style};
+
+mod footprint;
+pub mod layout;
+
+/// A named rectangle in an RGBA sprite atlas.
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SpriteEntry {
+    /// Left edge in atlas pixels.
+    pub x: u32,
+    /// Top edge in atlas pixels.
+    pub y: u32,
+    /// Width in atlas pixels.
+    pub width: u32,
+    /// Height in atlas pixels.
+    pub height: u32,
+    /// Atlas pixels per logical style pixel.
+    pub pixel_ratio: f32,
+    /// Convex visible-pixel envelope in coordinates local to the sprite rectangle.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub collision_hull: Vec<[u32; 2]>,
+}
+
+/// Named sprite rectangles transferred to tile workers without image bytes.
+pub type SpriteIndex = BTreeMap<String, SpriteEntry>;
+
+/// Decoded atlas shared by the rendering context.
+#[derive(Debug)]
+pub struct SpriteImage {
+    /// Image width in pixels.
+    pub width: u32,
+    /// Image height in pixels.
+    pub height: u32,
+    /// Straight RGBA bytes.
+    pub pixels: Vec<u8>,
+}
+
+/// Sprite failures retain the asset URL and underlying cause.
+#[derive(Debug, Error)]
+pub enum SpriteError {
+    /// An icon layer needs a sprite resource.
+    #[error("symbol layer {layer} declares icon-image without a sprite URL")]
+    MissingAtlas {
+        /// Style layer identifier.
+        layer: String,
+    },
+    /// Asset could not be retrieved.
+    #[error("cannot fetch sprite asset {url}")]
+    Fetch {
+        /// Requested URL.
+        url: String,
+        /// Transport error.
+        #[source]
+        source: SourceFetchError,
+    },
+    /// Index is not valid JSON.
+    #[error("cannot decode sprite index {url}")]
+    Index {
+        /// Requested URL.
+        url: String,
+        /// JSON error.
+        #[source]
+        source: serde_json::Error,
+    },
+    /// PNG could not be decoded.
+    #[error("cannot decode sprite image {url}")]
+    Image {
+        /// Requested URL.
+        url: String,
+        /// Image error.
+        #[source]
+        source: image::ImageError,
+    },
+    /// A requested artwork footprint is absent or invalid.
+    #[error("sprite {id} in {url} has no valid convex collision hull")]
+    CollisionHull {
+        /// Sprite identifier.
+        id: String,
+        /// Index URL.
+        url: String,
+    },
+    /// A sprite rectangle does not fit the image.
+    #[error("sprite {id} in {url} has invalid dimensions or pixel ratio")]
+    Rectangle {
+        /// Sprite identifier.
+        id: String,
+        /// Index URL.
+        url: String,
+    },
+}
+
+/// Fetch a style's single sprite atlas and attach only its index to icon layers.
+pub async fn resolve_sprite<HC: HttpClient>(
+    style: &mut Style,
+    client: &SourceClient<HC>,
+) -> Result<(), SpriteError> {
+    if !style.uses_chart_symbols() {
+        return Ok(());
+    }
+    for layer in &mut style.layers {
+        if let Some(LayerPaint::Symbol(paint)) = &mut layer.paint {
+            paint.chart = true;
+        }
+    }
+    let Some(base) = style.sprite.as_ref().and_then(serde_json::Value::as_str) else {
+        for layer in &style.layers {
+            if matches!(&layer.paint, Some(LayerPaint::Symbol(paint)) if paint.icon.image.is_some())
+            {
+                return Err(SpriteError::MissingAtlas {
+                    layer: layer.id.clone(),
+                });
+            }
+        }
+        return Ok(());
+    };
+    let index_url = format!("{base}.json");
+    let image_url = format!("{base}.png");
+    let index_bytes = client
+        .fetch_url(&index_url)
+        .await
+        .map_err(|source| SpriteError::Fetch {
+            url: index_url.clone(),
+            source,
+        })?;
+    let bytes = client
+        .fetch_url(&image_url)
+        .await
+        .map_err(|source| SpriteError::Fetch {
+            url: image_url.clone(),
+            source,
+        })?;
+    let index: SpriteIndex =
+        serde_json::from_slice(&index_bytes).map_err(|source| SpriteError::Index {
+            url: index_url.clone(),
+            source,
+        })?;
+    let image = image::load_from_memory(&bytes)
+        .map_err(|source| SpriteError::Image {
+            url: image_url,
+            source,
+        })?
+        .into_rgba8();
+    validate_index(&index, image.width(), image.height(), &index_url)?;
+    let artwork = style
+        .layers
+        .iter()
+        .any(|layer| super::collision::policy(layer).is_some_and(|policy| policy.artwork));
+    footprint::validate(&index, &index_url, artwork)?;
+    let index = Arc::new(index);
+    for layer in &mut style.layers {
+        if let Some(LayerPaint::Symbol(paint)) = &mut layer.paint {
+            if paint.icon.image.is_some() {
+                paint.icon.index = index.clone();
+            }
+        }
+    }
+    style.sprite_image = Some(Arc::new(SpriteImage {
+        width: image.width(),
+        height: image.height(),
+        pixels: image.into_raw(),
+    }));
+    Ok(())
+}
+
+fn validate_index(
+    index: &SpriteIndex,
+    width: u32,
+    height: u32,
+    url: &str,
+) -> Result<(), SpriteError> {
+    for (id, entry) in index {
+        if id.is_empty()
+            || entry.width == 0
+            || entry.height == 0
+            || !entry.pixel_ratio.is_finite()
+            || entry.pixel_ratio <= 0.0
+            || entry.x.checked_add(entry.width).is_none_or(|x| x > width)
+            || entry.y.checked_add(entry.height).is_none_or(|y| y > height)
+        {
+            return Err(SpriteError::Rectangle {
+                id: id.clone(),
+                url: url.into(),
+            });
+        }
+    }
+    Ok(())
+}
