+//! Evaluated placement in the shaper's em coordinate system.
+
+use crate::{
+    legacy::style_types::SymbolAnchorType,
+    style::{
+        expression::{LegacyPropertySpec, PropertyKind, Value},
+        property::PropertyValue,
+    },
+};
+use serde::Serialize;
+
+/// Two-dimensional text offset measured in ems.
+#[derive(Debug, Clone, Serialize)]
+pub struct Offset(pub [f64; 2]);
+
+impl PropertyValue for Offset {
+    fn spec() -> LegacyPropertySpec {
+        LegacyPropertySpec::interpolated(PropertyKind::Array {
+            item: Box::new(PropertyKind::Number),
+            length: Some(2),
+        })
+    }
+    fn from_value(value: &Value) -> Option<Self> {
+        let Value::Array(values) = value else {
+            return None;
+        };
+        let [x, y] = values.as_slice() else {
+            return None;
+        };
+        Some(Self([x.as_number()?, y.as_number()?]))
+    }
+}
+
+/// Per-feature properties passed to the text shaper.
+#[derive(Clone)]
+pub struct Placement {
+    /// Maximum row width in ems; zero disables wrapping.
+    pub max_width: f64,
+    /// Offset in ems.
+    pub offset: [f64; 2],
+    /// Edge that meets the feature anchor.
+    pub anchor: SymbolAnchorType,
+    /// Clockwise rotation in degrees.
+    pub rotate: f64,
+}
+
+impl Default for Placement {
+    fn default() -> Self {
+        Self {
+            max_width: 10.0,
+            offset: [0.0; 2],
+            anchor: SymbolAnchorType::Center,
+            rotate: 0.0,
+        }
+    }
+}
+
+pub(super) fn anchor(value: &str) -> SymbolAnchorType {
+    match value {
+        "left" => SymbolAnchorType::Left,
+        "right" => SymbolAnchorType::Right,
+        "top" => SymbolAnchorType::Top,
+        "bottom" => SymbolAnchorType::Bottom,
+        "top-left" => SymbolAnchorType::TopLeft,
+        "top-right" => SymbolAnchorType::TopRight,
+        "bottom-left" => SymbolAnchorType::BottomLeft,
+        "bottom-right" => SymbolAnchorType::BottomRight,
+        _ => SymbolAnchorType::Center,
+    }
+}
