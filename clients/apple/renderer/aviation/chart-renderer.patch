+#![allow(clippy::expect_used, clippy::panic)]
+
+use super::{FontAtlas, FontError, GlyphSet};
+
+#[test]
+fn font_selection_preserves_each_face_bitmap_and_separate_texture_coordinates() {
+    let atlas = FontAtlas::chart().expect("chart atlas");
+    let width = atlas.get_texture_dimensions().0;
+    let mut origins = Vec::new();
+    for (name, data) in [
+        (
+            "Futura Medium",
+            include_bytes!("../../../../../data/futura-medium.pbf").as_slice(),
+        ),
+        (
+            "Futura Medium Italic",
+            include_bytes!("../../../../../data/futura-mediumitalic.pbf").as_slice(),
+        ),
+    ] {
+        let original = GlyphSet::try_from(data).expect("standalone face");
+        let (_, face) = atlas
+            .select(Some(&[name.to_owned()]))
+            .expect("selected face");
+        let glyph = &face.glyphs[&'H'];
+        let base = &original.glyphs[&'H'];
+        origins.push(glyph.tex_origin_y);
+        for row in 0..glyph.buffered_dimensions().1 as usize {
+            let packed = (glyph.tex_origin_y as usize + row) * width + glyph.tex_origin_x as usize;
+            let standalone = row * original.get_texture_dimensions().0 + base.tex_origin_x as usize;
+            let count = glyph.buffered_dimensions().0 as usize;
+            assert_eq!(
+                &atlas.get_texture_bytes()[packed..packed + count],
+                &original.get_texture_bytes()[standalone..standalone + count]
+            );
+        }
+    }
+    assert_ne!(origins[0], origins[1]);
+    let (_, default) = atlas.select(None).expect("default face");
+    assert!(default.glyphs.contains_key(&'→'));
+}
+
+#[test]
+fn explicit_fallback_order_and_missing_fonts_are_observable() {
+    let atlas = FontAtlas::chart().expect("chart atlas");
+    let stack = [
+        "Unavailable".to_owned(),
+        "Futura Medium Italic".to_owned(),
+        "Futura Medium".to_owned(),
+    ];
+    assert_eq!(
+        atlas.select(Some(&stack)).expect("fallback").0,
+        "Futura Medium Italic"
+    );
+    assert!(matches!(
+        atlas.select(Some(&stack[..1])),
+        Err(FontError::Missing { .. })
+    ));
+    assert!(matches!(
+        FontAtlas::from_resources(&[("Broken", &[255])]),
+        Err(FontError::Decode { .. })
+    ));
+}
+
+#[test]
+fn layout_font_selection_survives_the_style_layer_merge() {
+    let mut style = crate::style::text::TextStyle::default();
+    style
+        .merge_layout(&serde_json::json!({"text-font": ["Futura Medium Italic"]}))
+        .expect("font layout");
+    assert_eq!(style.font, Some(vec!["Futura Medium Italic".to_owned()]));
+}
