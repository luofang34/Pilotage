+//! Decode bounded delta contours at the symbol vertex grid precision.
+
+pub(super) fn decode(text: &str) -> Result<Vec<Vec<[f32; 2]>>, &'static str> {
+    let bytes = base64(text)?;
+    let mut input = bytes.as_slice();
+    let count = integer(&mut input)?;
+    if count > 4096 {
+        return Err("encoded path exceeds 4096 contours");
+    }
+    let mut lines = Vec::new();
+    let mut total = 0;
+    let mut previous = [0_i32; 2];
+    for _ in 0..count {
+        let code = integer(&mut input)?;
+        let length = if code == 1 { 4 } else { code };
+        if length < 2 || length > 8192 - total {
+            return Err("encoded path needs two points per contour and at most 8192 total");
+        }
+        total += length;
+        let mut points = contour(
+            &mut input,
+            if code == 1 { 2 } else { length },
+            &mut previous,
+        )?;
+        if code == 1 {
+            let a = points[0];
+            let b = points[1];
+            points = vec![a, [b[0], a[1]], b, [a[0], b[1]]];
+        }
+        lines.push(points);
+    }
+    if !input.is_empty() {
+        return Err("encoded path has trailing bytes");
+    }
+    Ok(lines)
+}
+
+fn contour(
+    input: &mut &[u8],
+    length: u32,
+    previous: &mut [i32; 2],
+) -> Result<Vec<[f32; 2]>, &'static str> {
+    let mut points = Vec::new();
+    for _ in 0..length {
+        for coordinate in &mut *previous {
+            let code = integer(input)?;
+            let delta = (code >> 1) as i32 ^ -((code & 1) as i32);
+            *coordinate = coordinate
+                .checked_add(delta)
+                .ok_or("paper coordinate overflow")?;
+            if !(-131_072..=131_072).contains(coordinate) {
+                return Err("encoded paper coordinates exceed 4096 logical pixels");
+            }
+        }
+        points.push((*previous).map(|axis| axis as f32 / 32.0));
+    }
+    Ok(points)
+}
+
+fn integer(input: &mut &[u8]) -> Result<u32, &'static str> {
+    let mut value = 0_u32;
+    for shift in (0..35).step_by(7) {
+        let Some((&byte, rest)) = input.split_first() else {
+            return Err("encoded paper path integer is truncated");
+        };
+        *input = rest;
+        if shift == 28 && byte > 15 {
+            return Err("encoded paper path integer exceeds 32 bits");
+        }
+        value |= u32::from(byte & 127) << shift;
+        if byte < 128 {
+            return Ok(value);
+        }
+    }
+    Err("encoded paper path integer exceeds 32 bits")
+}
+
+fn base64(text: &str) -> Result<Vec<u8>, &'static str> {
+    if text.len() % 4 == 1 {
+        return Err("encoded paper path has an invalid base64 length");
+    }
+    let mut result = Vec::with_capacity(text.len() * 3 / 4);
+    let mut accumulator = 0_u32;
+    let mut bits = 0;
+    for byte in text.bytes() {
+        let value = match byte {
+            b'A'..=b'Z' => byte - b'A',
+            b'a'..=b'z' => byte - b'a' + 26,
+            b'0'..=b'9' => byte - b'0' + 52,
+            b'-' => 62,
+            b'_' => 63,
+            _ => return Err("encoded paper path has a non-base64 character"),
+        };
+        accumulator = (accumulator << 6) | u32::from(value);
+        bits += 6;
+        if bits >= 8 {
+            bits -= 8;
+            result.push((accumulator >> bits) as u8);
+        }
+        accumulator &= (1 << bits) - 1;
+    }
+    if accumulator != 0 {
+        return Err("encoded paper path has nonzero base64 padding bits");
+    }
+    Ok(result)
+}
