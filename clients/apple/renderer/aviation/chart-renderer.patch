+#![allow(clippy::expect_used)]
+
+use crate::{
+    environment::{OffscreenKernel, OffscreenKernelConfig},
+    io::source_client::{HttpClient, ResourceProvider, SourceFetchError},
+    platform::ReqwestOffscreenKernelEnvironment,
+};
+use std::sync::{
+    atomic::{AtomicUsize, Ordering},
+    Arc,
+};
+
+struct LocalProvider(AtomicUsize);
+#[cfg_attr(not(feature = "thread-safe-futures"), async_trait::async_trait(?Send))]
+#[cfg_attr(feature = "thread-safe-futures", async_trait::async_trait)]
+impl ResourceProvider for LocalProvider {
+    async fn fetch(&self, url: &str) -> Option<Result<Vec<u8>, SourceFetchError>> {
+        self.0.fetch_add(1, Ordering::Relaxed);
+        Some(if url == "pilotage://fixture/0/0/0" {
+            Ok(vec![1, 2, 3])
+        } else {
+            Err(SourceFetchError::not_found(url))
+        })
+    }
+}
+
+#[tokio::test]
+async fn map_and_tile_worker_share_local_resources_without_http_fallback() {
+    let provider = Arc::new(LocalProvider(AtomicUsize::new(0)));
+    let client = super::ReqwestHttpClient::new::<String>(None)
+        .with_resource_provider(Some(provider.clone()));
+    assert_eq!(
+        client
+            .fetch("pilotage://fixture/0/0/0")
+            .await
+            .expect("map resource"),
+        vec![1, 2, 3]
+    );
+    let worker = ReqwestOffscreenKernelEnvironment::create(OffscreenKernelConfig {
+        cache_directory: None,
+        resource_provider: Some(provider.clone()),
+    });
+    let client = worker.source_client();
+    assert_eq!(
+        client
+            .fetch_url("pilotage://fixture/0/0/0")
+            .await
+            .expect("worker resource"),
+        vec![1, 2, 3]
+    );
+    let error = client
+        .fetch_url("pilotage://missing/0/0/0")
+        .await
+        .expect_err("missing local tile");
+    assert!(error.is_not_found());
+    assert_eq!(provider.0.load(Ordering::Relaxed), 3);
+}
