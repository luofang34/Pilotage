+//! Sprite quads share symbol anchors and the existing worker vertex format.
+
+use crate::{render::shaders::ShaderSymbolVertexNew, style::sprite::SpriteEntry};
+use lyon::tessellation::VertexBuffers;
+use thiserror::Error;
+
+/// An icon selected from a feature's properties.
+pub(super) struct IconInstance {
+    pub anchor: (f64, f64),
+    pub sprite: SpriteEntry,
+    pub feature_size: f32,
+    pub rotation_degrees: f32,
+    pub placement: crate::style::sprite::layout::placement::IconPlacement,
+    pub viewport_aligned: bool,
+}
+
+/// Icon geometry cannot silently lose a named asset or overflow its index buffer.
+#[derive(Debug, Error)]
+pub enum IconError {
+    /// The shaper could not construct a text bucket for its source layer.
+    #[error("text shaping failed for layer {layer} during {stage}")]
+    TextLayout {
+        /// Layer passed to the shaper.
+        layer: String,
+        /// Construction step without an output.
+        stage: &'static str,
+    },
+    /// The requested embedded text face could not be resolved or decoded.
+    #[error(transparent)]
+    Font(#[from] crate::sdf::chart::font_atlas::FontError),
+    /// A chart frame or marking could not be constructed.
+    #[error(transparent)]
+    PaperPath(#[from] super::paper_paths::PaperPathError),
+    /// Requested artwork is absent from the resolved sprite index.
+    #[error("sprite index has no icon named {name}")]
+    Missing {
+        /// Requested sprite identity.
+        name: String,
+    },
+    /// Quad indices exceed the GPU index representation.
+    #[error("cannot append an icon after {vertices} symbol vertices")]
+    IndexCapacity {
+        /// Existing vertex count.
+        vertices: usize,
+    },
+}
+
+pub(super) fn append_icons(
+    icons: &[IconInstance],
+    buffer: &mut VertexBuffers<ShaderSymbolVertexNew, u32>,
+) -> Result<(), IconError> {
+    for icon in icons {
+        let base = u32::try_from(buffer.vertices.len())
+            .ok()
+            .filter(|base| *base <= u32::MAX - 4)
+            .ok_or(IconError::IndexCapacity {
+                vertices: buffer.vertices.len(),
+            })?;
+        let sprite = &icon.sprite;
+        let half_width = sprite.width as f32 / sprite.pixel_ratio / 2.0;
+        let half_height = sprite.height as f32 / sprite.pixel_ratio / 2.0;
+        let shift_x = icon.placement.offset[0] as f32
+            + half_width * (1.0 - 2.0 * icon.placement.anchor[0] as f32);
+        let shift_y = icon.placement.offset[1] as f32
+            + half_height * (1.0 - 2.0 * icon.placement.anchor[1] as f32);
+        let (sine, cosine) = icon
+            .rotation_degrees
+            .rem_euclid(360.0)
+            .to_radians()
+            .sin_cos();
+        for (x, y, u, v) in [
+            (-half_width, -half_height, sprite.x, sprite.y),
+            (half_width, -half_height, sprite.x + sprite.width, sprite.y),
+            (
+                half_width,
+                half_height,
+                sprite.x + sprite.width,
+                sprite.y + sprite.height,
+            ),
+            (-half_width, half_height, sprite.x, sprite.y + sprite.height),
+        ] {
+            let (x, y) = (x + shift_x, y + shift_y);
+            buffer.vertices.push(ShaderSymbolVertexNew {
+                a_pos_offset: [
+                    icon.anchor.0 as i32,
+                    icon.anchor.1 as i32,
+                    ((x * cosine - y * sine) * 32.0).round() as i32,
+                    ((x * sine + y * cosine) * 32.0).round() as i32,
+                ],
+                a_data: [u, v, 0, 0],
+                a_pixeloffset: [
+                    0,
+                    0,
+                    (icon.feature_size * 256.0).round() as i32,
+                    i32::from(icon.viewport_aligned),
+                ],
+            });
+        }
+        buffer
+            .indices
+            .extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+    }
+    Ok(())
+}
