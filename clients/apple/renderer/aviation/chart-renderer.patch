+#![allow(clippy::expect_used, clippy::panic)]
+
+use super::GlyphSet;
+
+#[test]
+fn chart_atlas_draws_both_arrows_and_preserves_latin_glyphs() {
+    let latin = GlyphSet::try_from(include_bytes!("../../../../data/0-255.pbf").as_slice())
+        .expect("Latin glyph resource must decode");
+    let chart = GlyphSet::try_from(include_bytes!("../../../../data/chart-glyphs.pbf").as_slice())
+        .expect("Chart glyph resource must decode and fit the atlas");
+    assert_eq!(chart.glyphs.len(), latin.glyphs.len() + 2);
+    let (latin_width, latin_height) = latin.get_texture_dimensions();
+    let (chart_width, chart_height) = chart.get_texture_dimensions();
+    assert_eq!(
+        (chart_width, chart_height),
+        (latin_width + 88, latin_height)
+    );
+    for row in 0..latin_height {
+        assert_eq!(
+            &latin.get_texture_bytes()[row * latin_width..(row + 1) * latin_width],
+            &chart.get_texture_bytes()[row * chart_width..row * chart_width + latin_width]
+        );
+    }
+    for codepoint in ['←', '→'] {
+        let arrow = chart
+            .glyphs
+            .get(&codepoint)
+            .expect("Arrow must be available to shaping");
+        assert_eq!(arrow.advance(), 40);
+        assert_eq!(arrow.buffered_dimensions(), (44, 16));
+        let digit = chart.glyphs.get(&'0').expect("Course digit must exist");
+        let arrow_center = -(arrow.top_bearing as f32) + arrow.height as f32 / 2.0;
+        let digit_center = -(digit.top_bearing as f32) + digit.height as f32 / 2.0;
+        assert!((arrow_center - digit_center).abs() <= 1.0);
+        let mut ink = 0;
+        for y in 0..16 {
+            for x in 0..44 {
+                let index = (arrow.tex_origin_y as usize + y) * chart_width
+                    + arrow.tex_origin_x as usize
+                    + x;
+                if chart.get_texture_bytes()[index] > 191 {
+                    ink += 1;
+                }
+            }
+        }
+        assert!(ink > 80, "Arrow must contain visible SDF ink");
+    }
+}
