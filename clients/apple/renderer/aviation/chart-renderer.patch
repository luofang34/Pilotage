+//! Attribute emitted triangles to their labels before buffers reach the collision pass.
+
+use super::IconError;
+use crate::{
+    legacy::buckets::symbol_bucket::SymbolBucketBuffer, render::shaders::ShaderSymbolVertexNew,
+    sdf::Feature,
+};
+use lyon::{
+    geom::euclid::{Box2D, Point2D},
+    tessellation::VertexBuffers,
+};
+
+type Buffer = VertexBuffers<ShaderSymbolVertexNew, u32>;
+
+pub(super) fn text_buffer(
+    shaped: SymbolBucketBuffer,
+    labels: &[(String, f64, f64)],
+    viewport_aligned: bool,
+) -> Result<(Buffer, Vec<Feature>), IconError> {
+    let invalid = || IconError::TextLayout {
+        layer: "text".into(),
+        stage: "quad ownership",
+    };
+    let mut buffer = VertexBuffers::new();
+    buffer.vertices = shaped
+        .shared_vertices
+        .iter()
+        .map(|v| {
+            let mut vertex = ShaderSymbolVertexNew::new(v);
+            vertex.a_pixeloffset[3] = i32::from(viewport_aligned);
+            vertex
+        })
+        .collect();
+    for segment in &shaped.segments {
+        let end = segment
+            .index_offset
+            .checked_add(segment.index_length)
+            .ok_or_else(invalid)?;
+        let indices = shaped
+            .triangles
+            .indices
+            .get(segment.index_offset..end)
+            .ok_or_else(invalid)?;
+        for index in indices {
+            let global = segment
+                .vertex_offset
+                .checked_add(usize::from(*index))
+                .ok_or_else(invalid)?;
+            if global >= buffer.vertices.len() {
+                return Err(invalid());
+            }
+            buffer
+                .indices
+                .push(u32::try_from(global).map_err(|_| invalid())?);
+        }
+    }
+    let mut cursor: usize = 0;
+    let mut features = Vec::new();
+    for placed in shaped.placed_symbols {
+        let count = placed
+            .glyph_offsets
+            .len()
+            .checked_mul(6)
+            .ok_or_else(invalid)?;
+        let end = cursor.checked_add(count).ok_or_else(invalid)?;
+        if count > 0 {
+            let text = labels
+                .iter()
+                .find(|(_, x, y)| {
+                    *x as i16 == placed.anchor_point.x as i16
+                        && *y as i16 == placed.anchor_point.y as i16
+                })
+                .map(|(text, _, _)| text.clone())
+                .unwrap_or_default();
+            features.push(feature(cursor..end, &buffer, text).ok_or_else(invalid)?);
+        }
+        cursor = end;
+    }
+    if cursor != buffer.indices.len() {
+        return Err(invalid());
+    }
+    Ok((buffer, features))
+}
+
+fn feature(indices: std::ops::Range<usize>, buffer: &Buffer, text: String) -> Option<Feature> {
+    let owned = buffer.indices.get(indices.clone())?;
+    let first = buffer.vertices.get(*owned.first()? as usize)?;
+    let anchor = Point2D::new(first.a_pos_offset[0] as f32, first.a_pos_offset[1] as f32);
+    let mut min = Point2D::new(f32::INFINITY, f32::INFINITY);
+    let mut max = Point2D::new(f32::NEG_INFINITY, f32::NEG_INFINITY);
+    for index in owned {
+        let vertex = buffer.vertices.get(*index as usize)?;
+        let x = vertex.a_pos_offset[2] as f32 / 32.0;
+        let y = vertex.a_pos_offset[3] as f32 / 32.0;
+        min.x = min.x.min(x);
+        min.y = min.y.min(y);
+        max.x = max.x.max(x);
+        max.y = max.y.max(y);
+    }
+    Some(Feature {
+        parts: Default::default(),
+        data: Default::default(),
+        bbox: Box2D::new(min, max),
+        indices,
+        text_anchor: anchor,
+        str: text,
+    })
+}
+
+pub(super) fn append_geometry(start: usize, buffer: &Buffer, features: &mut Vec<Feature>) {
+    let mut cursor = start;
+    while cursor < buffer.indices.len() {
+        let first = &buffer.vertices[buffer.indices[cursor] as usize];
+        let anchor = &first.a_pos_offset[..2];
+        let end = buffer.indices[cursor..]
+            .iter()
+            .position(|index| buffer.vertices[*index as usize].a_pos_offset[..2] != *anchor)
+            .map_or(buffer.indices.len(), |offset| cursor + offset);
+        if let Some(feature) = feature(cursor..end, buffer, String::new()) {
+            features.push(feature);
+        }
+        cursor = end;
+    }
+}
+
