+//! Sprite interiors remain reserved while transparent corners permit nearby labels.
+
+#![allow(clippy::expect_used, clippy::panic)]
+
+use super::*;
+use crate::sdf::chart::collision_system::placement::{Bounds, PlacementIndex};
+
+fn entry(hull: Vec<[u32; 2]>) -> SpriteEntry {
+    SpriteEntry {
+        x: 0,
+        y: 0,
+        width: 100,
+        height: 100,
+        pixel_ratio: 1.0,
+        collision_hull: hull,
+    }
+}
+
+#[test]
+fn open_diamond_reserves_interior_and_releases_exterior_corners() {
+    let sprite = entry(vec![[50, 10], [90, 50], [50, 90], [10, 50]]);
+    let quad = [
+        ([0.0, 0.0], 1.0),
+        ([100.0, 0.0], 1.0),
+        ([100.0, 100.0], 1.0),
+        ([0.0, 100.0], 1.0),
+    ];
+    let shapes = project_hull(&sprite, quad, 0.5).expect("valid test fixture");
+    let mut index = PlacementIndex::new([512.0, 512.0]);
+    assert!(index.place_all(&shapes, true, true));
+    assert!(!index.place(Bounds([48.0, 48.0, 52.0, 52.0]), false, false));
+    assert!(index.place(Bounds([80.0, 80.0, 84.0, 84.0]), false, false));
+    assert!(!index.place(Bounds([89.8, 49.0, 90.2, 51.0]), false, false));
+}
+
+#[test]
+fn projection_uses_triangle_perspective_weights_and_preserves_rotated_geometry() {
+    let sprite = entry(vec![[25, 25], [75, 25], [75, 75], [25, 75]]);
+    // These screen positions and w values describe x/(1+x) perspective.
+    let quad = [
+        ([0.0, 0.0], 1.0),
+        ([50.0, 0.0], 2.0),
+        ([50.0, 50.0], 2.0),
+        ([0.0, 100.0], 1.0),
+    ];
+    let shapes = project_hull(&sprite, quad, 0.0).expect("valid test fixture");
+    for shape in shapes {
+        let Footprint::Polygon { points, .. } = shape else {
+            panic!("expected polygon")
+        };
+        for [x, y] in points {
+            let u = x / (100.0 - x);
+            let v = y * (1.0 + u) / 100.0;
+            assert!((0.25 - 1e-9..=0.75 + 1e-9).contains(&u));
+            assert!((0.25 - 1e-9..=0.75 + 1e-9).contains(&v));
+        }
+    }
+    let rotated = quad.map(|([x, y], w)| ([200.0 - y, 100.0 + x], w));
+    let shapes = project_hull(&sprite, rotated, 0.5).expect("valid test fixture");
+    let mut index = PlacementIndex::new([512.0, 512.0]);
+    assert!(index.place_all(&shapes, true, true));
+    assert!(!index.place(Bounds([164.0, 131.0, 168.0, 135.0]), false, false));
+    assert!(index.place(Bounds([190.0, 145.0, 194.0, 149.0]), false, false));
+}
+
+#[test]
+fn clipping_preserves_both_sides_of_the_gpu_diagonal() {
+    let diamond = [[0.5, 0.1], [0.9, 0.5], [0.5, 0.9], [0.1, 0.5]];
+    for upper in [true, false] {
+        let points = clip(&diamond, upper);
+        assert_eq!(points.len(), 4);
+        assert!(points
+            .iter()
+            .all(|[u, v]| if upper { u >= v } else { u <= v }));
+        assert!(points
+            .iter()
+            .any(|p| (p[0] - 0.3).abs() < 1e-9 && (p[1] - 0.3).abs() < 1e-9));
+        assert!(points
+            .iter()
+            .any(|p| (p[0] - 0.7).abs() < 1e-9 && (p[1] - 0.7).abs() < 1e-9));
+    }
+}
